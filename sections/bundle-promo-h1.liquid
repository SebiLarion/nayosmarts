<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1 {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1 {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__heading {
    margin: 0;
    max-width: 56.75rem;
    width: 100%;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 2rem;
    line-height: normal;
    letter-spacing: -0.48px;
    text-align: center;
    color: #1a1a1a;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__hero {
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media,
  #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 362 / 245;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media {
      aspect-ratio: 1296 / 570;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media img,
  #shopify-section-{{ section.id }} .bundle-promo-h1__row-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero-video,
  #shopify-section-{{ section.id }} .bundle-promo-h1__row-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__caption {
    margin: 0;
    max-width: 39.75rem;
    width: 100%;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__rows {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__rows {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
      aspect-ratio: 636 / 430.442;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-title {
    margin: 0;
    width: 100%;
    font-weight: 600;
    font-size: 1rem;
    line-height: normal;
    text-align: center;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-text {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    color: #171717;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__row {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 3rem;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row.is-reverse {
      flex-direction: row-reverse;
      justify-content: space-between;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
      width: 49.07%;
      flex-shrink: 0;
      aspect-ratio: 636 / 430.442;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-copy {
      width: 28%;
      max-width: 22.875rem;
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-title {
      font-family: var(--font-heading-family);
      font-size: 2.25rem;
      line-height: 1.5;
      letter-spacing: -0.48px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-text {
      text-align: left;
    }
  }
</style>

{%- liquid
  assign heading = section.settings.heading | default: 'Get the Backpack + Sling Bag bundle for an extra 15% off!'
  assign caption = section.settings.caption
  assign hero_video = section.settings.video
  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile | default: hero_image
  assign hero_fallback = 'bundle-promo-h1-hero.jpg'
  assign rows = section.blocks
  assign country_code = localization.country.iso_code | upcase
-%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="bundle-promo-h1">
      {%- if heading != blank -%}
        <h2 class="heading bundle-promo-h1__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      <div class="bundle-promo-h1__hero">
        <div class="bundle-promo-h1__hero-media">
          {%- if hero_video != blank -%}
            {%- render 'video',
              video: hero_video,
              muted: true,
              autoplay: true,
              loop: true,
              controls: false,
              show_play_button: true,
              cover_image: hero_image,
              description: heading,
              sizes: '(min-width: 768px) min(1296px, 100vw), 100vw',
              loading: 'lazy',
              fetchpriority: 'low',
              class: 'bundle-promo-h1__hero-video'
            -%}
          {%- elsif hero_image != blank -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ hero_image_mobile | image_url: width: 400 }} 400w, {{ hero_image_mobile | image_url: width: 800 }} 800w"
                >
              {%- endif -%}
              {{- hero_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,800,1200,1600,2000', sizes: '(min-width: 768px) min(1296px, 100vw), 100vw', alt: heading, is: 'lazy-image' -}}
            </picture>
          {%- else -%}
            <img src="{{ hero_fallback | asset_url }}" alt="{{ heading | escape }}" width="1296" height="570" loading="lazy">
          {%- endif -%}
        </div>
        {%- if caption != blank -%}
          <p class="bundle-promo-h1__caption">{{ caption | escape }}</p>
        {%- endif -%}
      </div>

      {%- if rows.size > 0 -%}
        <div class="bundle-promo-h1__rows">
          {%- for block in rows -%}
            {%- liquid
              assign row_video = block.settings.video
              assign row_image = block.settings.image
              assign row_image_mobile = block.settings.image_mobile | default: row_image
              assign row_heading = block.settings.heading
              assign row_text = block.settings.text
              assign market_gift_product = blank
              assign market_gift_description_source = 'theme_editor'
              assign market_gift_image_source = 'product_gallery'
              assign reverse = false
              if block.settings.layout == 'text_first'
                assign reverse = true
              endif

              if block.type == 'market_gift'
                assign market_gift_product = block.settings.product_default
                if country_code == 'US' and block.settings.product_us != blank
                  assign market_gift_product = block.settings.product_us
                endif

                assign market_2_codes = block.settings.market_2_countries | upcase | replace: ' ', '' | split: ','
                if block.settings.market_2_product != blank
                  for code in market_2_codes
                    if code == country_code
                      assign market_gift_product = block.settings.market_2_product
                    endif
                  endfor
                endif

                assign market_3_codes = block.settings.market_3_countries | upcase | replace: ' ', '' | split: ','
                if block.settings.market_3_product != blank
                  for code in market_3_codes
                    if code == country_code
                      assign market_gift_product = block.settings.market_3_product
                    endif
                  endfor
                endif

                if market_gift_product != blank
                  assign market_gift_variant = market_gift_product.selected_or_first_available_variant
                  assign row_image = market_gift_variant.featured_media | default: market_gift_product.featured_media
                  assign market_gift_description = market_gift_product.metafields.custom.free_gift_description.value
                  assign market_gift_promo_image = market_gift_product.metafields.custom.freebie_promo_image.value
                  if market_gift_description != blank
                    assign row_text = market_gift_description
                    assign market_gift_description_source = 'metafield'
                  endif
                  if market_gift_promo_image != blank
                    assign row_image = market_gift_promo_image
                    assign market_gift_image_source = 'metafield'
                  endif
                  assign row_image_mobile = row_image
                  assign row_video = blank
                  assign row_heading = block.settings.heading | append: ' ' | append: market_gift_product.title
                endif
              endif

              assign row_fallback = 'bundle-promo-h1-row-1.jpg'
              if forloop.index == 2
                assign row_fallback = 'bundle-promo-h1-row-2.jpg'
              elsif forloop.index == 3
                assign row_fallback = 'bundle-promo-h1-row-3.jpg'
              elsif forloop.index == 4
                assign row_fallback = 'bundle-promo-h1-row-4.jpg'
              endif
            -%}
            <div
              class="bundle-promo-h1__row{% if reverse %} is-reverse{% endif %}"
              {% if block.type == 'market_gift' %}
                data-market-country="{{ country_code | escape }}"
                data-market-gift="{{ market_gift_product.handle | escape }}"
                data-market-gift-description-source="{{ market_gift_description_source }}"
                data-market-gift-image-source="{{ market_gift_image_source }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="bundle-promo-h1__row-media">
                {%- if row_video != blank -%}
                  {%- render 'video',
                    video: row_video,
                    muted: true,
                    autoplay: true,
                    loop: true,
                    controls: false,
                    show_play_button: false,
                    cover_image: row_image,
                    description: row_heading,
                    sizes: '(min-width: 768px) min(636px, 50vw), 100vw',
                    loading: 'lazy',
                    fetchpriority: 'low',
                    class: 'bundle-promo-h1__row-video'
                  -%}
                {%- elsif row_image != blank -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ row_image_mobile | image_url: width: 400 }} 400w, {{ row_image_mobile | image_url: width: 800 }} 800w"
                      >
                    {%- endif -%}
                    {{- row_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,800,1200', sizes: '(min-width: 768px) min(636px, 50vw), 100vw', alt: row_heading, is: 'lazy-image' -}}
                  </picture>
                {%- else -%}
                  <img src="{{ row_fallback | asset_url }}" alt="{{ row_heading | escape }}" width="636" height="430" loading="lazy">
                {%- endif -%}
              </div>
              <div class="bundle-promo-h1__row-copy">
                {%- if row_heading != blank -%}
                  <h3 class="bundle-promo-h1__row-title">{{ row_heading | escape }}</h3>
                {%- endif -%}
                {%- if row_text != blank -%}
                  <p class="bundle-promo-h1__row-text">{{ row_text | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bundle promo (H1)",
  "class": "bundle-promo-h1-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Get the Backpack + Sling Bag bundle for an extra 15% off!"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Crafted with military-grade materials, this backpack is built to withstand the harshest conditions, ensuring your gear stays safe and dry."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Displays instead of the image when selected."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.global.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image left"
            },
            {
              "value": "text_first",
              "label": "Image right"
            }
          ],
          "default": "image_first"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Displays instead of the image when selected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.global.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.global.settings.text.label"
        }
      ]
    },
    {
      "type": "market_gift",
      "name": "Market gift",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the gift assigned to the customer's active country, using the same market pattern as the free gift near the product form."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image left"
            },
            {
              "value": "text_first",
              "label": "Image right"
            }
          ],
          "default": "text_first"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading prefix",
          "default": "Included in your purchase:"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.global.settings.text.label",
          "default": "Keep your essentials organized and dry with this bonus gift."
        },
        {
          "type": "header",
          "content": "All other markets"
        },
        {
          "type": "product",
          "id": "product_default",
          "label": "Gift product"
        },
        {
          "type": "header",
          "content": "United States"
        },
        {
          "type": "product",
          "id": "product_us",
          "label": "Gift product for United States"
        },
        {
          "type": "header",
          "content": "Extra markets"
        },
        {
          "type": "paragraph",
          "content": "Optional. Use comma-separated ISO country codes such as CA, GB, AU. Extra markets override the default and United States products."
        },
        {
          "type": "text",
          "id": "market_2_countries",
          "label": "Countries 2"
        },
        {
          "type": "product",
          "id": "market_2_product",
          "label": "Gift product 2"
        },
        {
          "type": "text",
          "id": "market_3_countries",
          "label": "Countries 3"
        },
        {
          "type": "product",
          "id": "market_3_product",
          "label": "Gift product 3"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Bundle promo (H1)",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "layout": "image_first",
            "heading": "Ergonomic Design",
            "text": "Comfortable shoulder straps and back panel for all-day wear."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "text_first",
            "heading": "Modular Storage",
            "text": "Customizable compartments to fit your specific needs."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "image_first",
            "heading": "Integrated Hydration",
            "text": "Pocket for a water bladder and hose routing."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "text_first",
            "heading": "Included in your purchase: Waterproof Toiletry Bag",
            "text": "Keep your essentials organized and dry with this bonus gift."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
