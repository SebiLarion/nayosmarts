<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1 {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1 {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__heading {
    margin: 0;
    max-width: 56.75rem;
    width: 100%;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 2rem;
    line-height: normal;
    letter-spacing: -0.48px;
    text-align: center;
    color: #1a1a1a;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__hero {
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media,
  #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 362 / 245;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media {
      aspect-ratio: 1296 / 570;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__hero-media img,
  #shopify-section-{{ section.id }} .bundle-promo-h1__row-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__caption {
    margin: 0;
    max-width: 39.75rem;
    width: 100%;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__rows {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__rows {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
      aspect-ratio: 636 / 430.442;
    }
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-title {
    margin: 0;
    width: 100%;
    font-weight: 600;
    font-size: 1rem;
    line-height: normal;
    text-align: center;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .bundle-promo-h1__row-text {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    color: #171717;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .bundle-promo-h1__row {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 3rem;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row.is-reverse {
      flex-direction: row-reverse;
      justify-content: space-between;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-media {
      width: 49.07%;
      flex-shrink: 0;
      aspect-ratio: 636 / 430.442;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-copy {
      width: 28%;
      max-width: 22.875rem;
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-title {
      font-family: var(--font-heading-family);
      font-size: 2.25rem;
      line-height: 1.5;
      letter-spacing: -0.48px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .bundle-promo-h1__row-text {
      text-align: left;
    }
  }
</style>

{%- liquid
  assign heading = section.settings.heading | default: 'Get the Backpack + Sling Bag bundle for an extra 15% off!'
  assign caption = section.settings.caption
  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile | default: hero_image
  assign hero_fallback = 'bundle-promo-h1-hero.jpg'
  assign rows = section.blocks | where: 'type', 'row'
-%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="bundle-promo-h1">
      {%- if heading != blank -%}
        <h2 class="heading bundle-promo-h1__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      <div class="bundle-promo-h1__hero">
        <div class="bundle-promo-h1__hero-media">
          {%- if hero_image != blank -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ hero_image_mobile | image_url: width: 400 }} 400w, {{ hero_image_mobile | image_url: width: 800 }} 800w"
                >
              {%- endif -%}
              {{- hero_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,800,1200,1600,2000', sizes: '(min-width: 768px) min(1296px, 100vw), 100vw', alt: heading, is: 'lazy-image' -}}
            </picture>
          {%- else -%}
            <img src="{{ hero_fallback | asset_url }}" alt="{{ heading | escape }}" width="1296" height="570" loading="lazy">
          {%- endif -%}
        </div>
        {%- if caption != blank -%}
          <p class="bundle-promo-h1__caption">{{ caption | escape }}</p>
        {%- endif -%}
      </div>

      {%- if rows.size > 0 -%}
        <div class="bundle-promo-h1__rows">
          {%- for block in rows -%}
            {%- liquid
              assign row_image = block.settings.image
              assign row_image_mobile = block.settings.image_mobile | default: row_image
              assign row_heading = block.settings.heading
              assign row_text = block.settings.text
              assign reverse = false
              if block.settings.layout == 'text_first'
                assign reverse = true
              endif

              assign row_fallback = 'bundle-promo-h1-row-1.jpg'
              if forloop.index == 2
                assign row_fallback = 'bundle-promo-h1-row-2.jpg'
              elsif forloop.index == 3
                assign row_fallback = 'bundle-promo-h1-row-3.jpg'
              elsif forloop.index == 4
                assign row_fallback = 'bundle-promo-h1-row-4.jpg'
              endif
            -%}
            <div
              class="bundle-promo-h1__row{% if reverse %} is-reverse{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="bundle-promo-h1__row-media">
                {%- if row_image != blank -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ row_image_mobile | image_url: width: 400 }} 400w, {{ row_image_mobile | image_url: width: 800 }} 800w"
                      >
                    {%- endif -%}
                    {{- row_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,800,1200', sizes: '(min-width: 768px) min(636px, 50vw), 100vw', alt: row_heading, is: 'lazy-image' -}}
                  </picture>
                {%- else -%}
                  <img src="{{ row_fallback | asset_url }}" alt="{{ row_heading | escape }}" width="636" height="430" loading="lazy">
                {%- endif -%}
              </div>
              <div class="bundle-promo-h1__row-copy">
                {%- if row_heading != blank -%}
                  <h3 class="bundle-promo-h1__row-title">{{ row_heading | escape }}</h3>
                {%- endif -%}
                {%- if row_text != blank -%}
                  <p class="bundle-promo-h1__row-text">{{ row_text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bundle promo (H1)",
  "class": "bundle-promo-h1-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Get the Backpack + Sling Bag bundle for an extra 15% off!"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Crafted with military-grade materials, this backpack is built to withstand the harshest conditions, ensuring your gear stays safe and dry."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.global.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image left"
            },
            {
              "value": "text_first",
              "label": "Image right"
            }
          ],
          "default": "image_first"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.global.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.global.settings.text.label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Bundle promo (H1)",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "layout": "image_first",
            "heading": "Ergonomic Design",
            "text": "Comfortable shoulder straps and back panel for all-day wear."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "text_first",
            "heading": "Modular Storage",
            "text": "Customizable compartments to fit your specific needs."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "image_first",
            "heading": "Integrated Hydration",
            "text": "Pocket for a water bladder and hose routing."
          }
        },
        {
          "type": "row",
          "settings": {
            "layout": "text_first",
            "heading": "Included in your purchase: Waterproof Toiletry Bag",
            "text": "Keep your essentials organized and dry with this bonus gift."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
