    align-items: center;
    justify-content: center;
    min-height: 2.6875rem;
    padding: 0.75rem 1rem !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    line-height: normal !important;
    color: #f6f6f6 !important;
    background: #171717 !important;
    border: 0 !important;
    border-radius: 0 !important;
    border-bottom: 4px solid #e4452a !important;
    border-right: 4px solid #e4452a !important;
    box-shadow: none !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .jdgm-write-rev-link {
    display: inline-flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: static !important;
    float: none !important;
    inset: auto !important;
    align-items: center;
    justify-content: center;
    box-sizing: border-box !important;
    width: auto !important;
    min-width: 9.6875rem;
    max-width: 100%;
    min-height: 2.6875rem;
    margin: 0 !important;
    padding: 0.75rem 1rem !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    line-height: normal !important;
    color: #171717 !important;
    background: transparent !important;
    border: 1px solid #171717 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    text-decoration: none !important;
    text-transform: none !important;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .jdgm-paginate {
    display: flex !important;
    justify-content: center;
    margin: 1.5rem 0 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-paginate__load-more {
    width: 13.25rem;
    font-size: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-paginate__load-more::after {
    content: 'See More';
    font-size: 1rem;
    font-weight: 600;
    line-height: normal;
    color: #f6f6f6;
  }

  /* Review cards */
  #shopify-section-{{ section.id }} .jdgm-rev-widg__body {
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg__reviews {
    display: flex !important;
    flex-direction: column;
    gap: 1.5rem;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .jdgm-rev-widg__reviews {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.5rem;
      row-gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .jdgm-rev {
    display: flex !important;
    flex-direction: column !important;
    float: none !important;
    clear: both !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 0 1.5rem !important;
    border: 0 !important;
    border-bottom: 1px solid rgb(26 26 26 / 0.12) !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .jdgm-rev {
      padding-bottom: 0 !important;
      border-bottom: 0 !important;
    }
  }

  #shopify-section-{{ section.id }} .jdgm-rev__header,
  #shopify-section-{{ section.id }} .jdgm-rev__content,
  #shopify-section-{{ section.id }} .jdgm-rev__actions {
    float: none !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-rev__header {
    display: block !important;
    margin: 0 0 0.5rem !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-row-product,
  #shopify-section-{{ section.id }} .jdgm-rev__br,
  #shopify-section-{{ section.id }} .jdgm-row-extra,
  #shopify-section-{{ section.id }} .jdgm-rev__social,
  #shopify-section-{{ section.id }} .jdgm-rev__custom-form {
