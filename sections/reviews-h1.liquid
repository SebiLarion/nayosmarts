  #shopify-section-{{ section.id }} .jdgm-rev__thumb-count {
    color: #171717 !important;
    font-size: 0.75rem !important;
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative reviews-h1">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var BATCH_SIZE = 6;
    var MAX_LOAD_MORE_CLICKS = 8;
    var loadMoreClicks = 0;
    var loadingMore = false;
    var autoLoadDone = false;
    var expandTarget = 0;

    var reviewCount = function () {
      return root.querySelectorAll('.jdgm-rev').length;
    };

    var loadMoreButton = function () {
      return root.querySelector('.jdgm-paginate__load-more');
    };

    var widgetReady = function () {
      return !!(root.querySelector('.jdgm--done-setup-widget') && window.jdgm && jdgm.$);
    };

    var revealWriteReview = function () {
      root.querySelectorAll('.jdgm-write-rev-link').forEach(function (el) {
        if (el.getAttribute('href') === '#') el.setAttribute('href', 'javascript:void(0)');
        if (el.style.display === 'inline-flex') return;
        el.style.setProperty('display', 'inline-flex', 'important');
        el.style.setProperty('visibility', 'visible', 'important');
        el.style.setProperty('opacity', '1', 'important');
      });
    };

    var triggerLoadMore = function (btn) {
      if (window.jdgm && jdgm.$) {
        jdgm.$(btn).trigger('click');
        return;
      }
      btn.click();
    };

    var waitForIncrease = function (before, callback) {
      var elapsed = 0;
      var timer = setInterval(function () {
        elapsed += 100;
        if (reviewCount() > before) {
          clearInterval(timer);
          callback(true);
        } else if (elapsed >= 3000) {
          clearInterval(timer);
          callback(false);
        }
      }, 100);
    };

    var prefetchReviews = function () {
      if (autoLoadDone || loadingMore) return;
      if (reviewCount() >= BATCH_SIZE) {
        autoLoadDone = true;
        return;
      }
      if (!widgetReady()) return;

      var btn = loadMoreButton();
      if (!btn) {
        autoLoadDone = true;
        return;
      }
      if (loadMoreClicks >= MAX_LOAD_MORE_CLICKS) {
        autoLoadDone = true;
        return;
      }

      loadMoreClicks += 1;
      loadingMore = true;
      var before = reviewCount();
      triggerLoadMore(btn);

      waitForIncrease(before, function (grew) {
        loadingMore = false;
        if (grew) {
          prefetchReviews();
          return;
        }
        if (loadMoreClicks >= MAX_LOAD_MORE_CLICKS) autoLoadDone = true;
      });
    };

    var expandToTarget = function () {
      if (!expandTarget || loadingMore) return;
      if (reviewCount() >= expandTarget) {
        expandTarget = 0;
        return;
      }

      var btn = loadMoreButton();
      if (!btn) {
        expandTarget = 0;
        return;
      }

      loadingMore = true;
      var before = reviewCount();
      triggerLoadMore(btn);
      waitForIncrease(before, function (grew) {
        loadingMore = false;
        if (grew) {
          setTimeout(expandToTarget, 350);
          return;
        }
        expandTarget = 0;
      });
    };

    root.addEventListener(
      'click',
      function (event) {
        var btn = event.target.closest && event.target.closest('.jdgm-paginate__load-more');
        if (!btn || !event.isTrusted || !autoLoadDone || expandTarget) return;

        var before = reviewCount();
        expandTarget = before + BATCH_SIZE;
        waitForIncrease(before, function (grew) {
          if (grew) setTimeout(expandToTarget, 350);
          else expandTarget = 0;
        });
      },
      true
    );

    revealWriteReview();
    prefetchReviews();
    new MutationObserver(function () {
      revealWriteReview();
      prefetchReviews();
    }).observe(root, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class']
    });

    var polls = 0;
    var poll = setInterval(function () {
      polls += 1;
      revealWriteReview();
      prefetchReviews();
      if (autoLoadDone || polls >= 60) clearInterval(poll);
    }, 250);
  })();
</script>

{% schema %}
{
  "name": "t:sections.reviews-h1.name",
  "class": "section-reviews-h1",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Ratings"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "t:sections.global.settings.color_highlight.label"
    },
    {
      "type": "color_background",
      "id": "gradient_highlight",
      "label": "t:sections.global.settings.gradient_highlight.label"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:sections.global.settings.color_button_text.label"
    },
    {
      "type": "color",
      "id": "color_button_background",
      "label": "t:sections.global.settings.color_button_background.label"
    },
    {
      "type": "color_background",
      "id": "color_button_gradient",
      "label": "t:sections.global.settings.color_button_gradient.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    }
  ],
