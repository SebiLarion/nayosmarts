<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .reviews-h1 {
    position: relative;
    z-index: 1;
    max-width: 100%;
    min-width: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .page-width > div,
  #shopify-section-{{ section.id }} .jdgm-widget,
  #shopify-section-{{ section.id }} .jdgm-rev-widg,
  #shopify-section-{{ section.id }} #judgeme_product_reviews {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-inline: 0 !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
  }

  #shopify-section-{{ section.id }} #judgeme_product_reviews {
    scroll-margin-top: calc(var(--header-height, 5rem) + 1rem);
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg {
    padding: 0 !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: inherit !important;
    color: #171717 !important;
  }

  /* Header: Ratings + Write a review on one row; photos/videos + badges below */
  #shopify-section-{{ section.id }} .jdgm-rev-widg__header {
    position: relative !important;
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title write'
      'media media';
    grid-auto-flow: row;
    align-items: center;
    column-gap: 1rem;
    row-gap: 1.5rem;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 0 3rem !important;
    padding: 0 !important;
    border: 0 !important;
    overflow: visible !important;
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg__header > *:not(.jdgm-rev-widg__title):not(.jdgm-row-stars):not(.jdgm-row-media):not(.jdgm-widget-actions-wrapper):not(.jdgm-form-wrapper):not(.jdgm-form-dynamic-wrapper) {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .jdgm-form-wrapper,
  #shopify-section-{{ section.id }} .jdgm-form-dynamic-wrapper {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .jdgm-form-dynamic-wrapper {
    z-index: 1050;
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg__title {
    grid-area: title;
    min-width: 0;
    margin: 0 !important;
    padding: 0 !important;
    font-family: var(--font-heading-family) !important;
    font-weight: 600 !important;
    font-size: 2rem !important;
    line-height: normal !important;
    letter-spacing: -0.48px !important;
    color: #1a1a1a !important;
    text-align: start !important;
    text-transform: none !important;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .jdgm-rev-widg__title {
      font-size: 3rem !important;
    }
  }

  {%- if section.settings.heading != blank %}
  #shopify-section-{{ section.id }} .jdgm-rev-widg__title {
    font-size: 0 !important;
    line-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg__title::before {
    content: {{ section.settings.heading | json }};
    display: block;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 2rem;
    line-height: normal;
    letter-spacing: -0.48px;
    color: #1a1a1a;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .jdgm-rev-widg__title::before {
      font-size: 3rem;
    }
  }
  {% endif -%}

  #shopify-section-{{ section.id }} .jdgm-row-stars,
  #shopify-section-{{ section.id }} .jdgm-widget-actions-wrapper {
    grid-area: write;
    position: static !important;
    float: none !important;
    inset: auto !important;
    display: flex !important;
    align-items: center;
    justify-content: flex-end;
    width: auto !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-rev-widg__summary,
  #shopify-section-{{ section.id }} .jdgm-histogram,
  #shopify-section-{{ section.id }} .jdgm-row-actions {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .jdgm-row-media {
    grid-area: media;
    position: static !important;
    float: none !important;
    inset: auto !important;
    display: flex !important;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-gallery-wrapper {
    flex: 1 1 16rem;
    min-width: 0;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-medals-wrapper {
    flex: 0 1 auto;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-gallery-title {
    font-size: 1rem !important;
    font-weight: 600 !important;
    color: #171717 !important;
    margin: 0 0 0.75rem !important;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .jdgm-row-media {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .jdgm-gallery-wrapper,
    #shopify-section-{{ section.id }} .jdgm-medals-wrapper {
      flex: none;
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 !important;
      border: 0 !important;
    }

    #shopify-section-{{ section.id }} .jdgm-gallery {
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
    }

    #shopify-section-{{ section.id }} .jdgm-gallery__thumbnail-link,
    #shopify-section-{{ section.id }} .jdgm-gallery__thumbnail-wrapper {
      display: block !important;
      float: none !important;
      width: 100% !important;
      max-width: none !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      aspect-ratio: 1;
    }

    #shopify-section-{{ section.id }} .jdgm-gallery__thumbnail,
    #shopify-section-{{ section.id }} .jdgm-gallery__thumbnail-wrapper img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .jdgm-medals,
    #shopify-section-{{ section.id }} .jdgm-medals__container {
      display: flex !important;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.25rem;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
    }

    #shopify-section-{{ section.id }} .jdgm-medal-wrapper {
      margin: 0 !important;
    }
  }

  #shopify-section-{{ section.id }} .jdgm-star,
  #shopify-section-{{ section.id }} .jdgm-star:before {
    color: #171717 !important;
  }

  #shopify-section-{{ section.id }} .jdgm-star.jdgm--off:before,
  #shopify-section-{{ section.id }} .jdgm-star.jdgm--half:after {
    color: rgb(23 23 23 / 0.18) !important;
  }

  /* Buttons */
