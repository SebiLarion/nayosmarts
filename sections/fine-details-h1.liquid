<script src="{{ 'fine-details-h1.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .fine-details-h1__heading {
    margin: 0 auto 1.5rem;
    width: 100%;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 2rem;
    line-height: normal;
    letter-spacing: -0.48px;
    text-align: center;
    color: #1a1a1a;
    position: relative;
    z-index: 1;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: 24px;
      --section-padding-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .fine-details-h1__heading {
      margin-bottom: 1rem;
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 362 / 447;
    background: #d9d4cb;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .fine-details-h1 {
    container-type: inline-size;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__canvas {
    position: relative;
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__stage {
      aspect-ratio: auto;
      width: 100%;
      height: calc(100svh - var(--header-height, 0px) - var(--section-padding-top) - 3.25rem);
      min-height: 42rem;
      max-height: 81rem;
      margin-inline: 0;
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__view {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__view[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__scene {
    position: absolute;
    inset: 0 0 6.75rem;
    overflow: hidden;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__scene {
      inset: auto;
      top: 0;
      bottom: 5.75rem;
      left: 50%;
      width: auto;
      height: calc(100% - 5.75rem);
      aspect-ratio: 1 / 1;
      max-width: 100%;
      transform: translateX(-50%);
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__media {
    position: absolute;
    left: 50%;
    top: 40.5%;
    width: 72.4%;
    height: 58%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__media {
      top: 50%;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .fine-details-h1__media img {
      transform: scale(1.08);
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__media picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__media picture,
  #shopify-section-{{ section.id }} .fine-details-h1__media img,
  #shopify-section-{{ section.id }} .fine-details-h1__media svg {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__media img,
  #shopify-section-{{ section.id }} .fine-details-h1__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'hotspot' -%}
      #shopify-section-{{ section.id }} #shopify-block-{{ block.id }} {
        --hotspot-x: {{ block.settings.horizontal }}%;
        --hotspot-y: {{ block.settings.vertical }}%;
      }
    {%- endif -%}
  {%- endfor -%}

  @media screen and (max-width: 767px) {
    {%- for block in section.blocks -%}
      {%- if block.type == 'hotspot' -%}
        #shopify-section-{{ section.id }} #shopify-block-{{ block.id }} {
          --hotspot-x: {{ block.settings.horizontal_mobile }}%;
          --hotspot-y: {{ block.settings.vertical_mobile }}%;
        }
      {%- endif -%}
    {%- endfor -%}
  }

  #shopify-section-{{ section.id }} .fine-details-h1__hotspot {
    position: absolute;
    z-index: 1;
    left: var(--hotspot-x);
    top: var(--hotspot-y);
    width: 8.29%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__hotspot {
      width: 9.11%;
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__hotspot img {
    display: block;
    width: 100%;
    height: auto;
    animation: hotspot 2s ease infinite;
  }

  #shopify-section-{{ section.id }} .fine-details-h1__tabs {
    position: absolute;
    z-index: 2;
    left: 1rem;
    right: 1rem;
    bottom: 1.3125rem;
    display: flex;
    justify-content: space-between;
    gap: 0.8125rem;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__tabs {
      left: 50%;
      right: auto;
      bottom: 1.5rem;
      width: max-content;
      justify-content: center;
      transform: translateX(-50%);
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__tab {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.3125rem;
    min-height: 3.1875rem;
    padding: 1rem;
    border: 1px solid rgb(23 23 23 / 0.16);
    background: transparent;
    color: #171717;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .fine-details-h1__tab {
      min-height: 3.5rem;
    }
  }

  #shopify-section-{{ section.id }} .fine-details-h1__tab[aria-selected="true"] {
    border-color: #171717;
    font-weight: 600;
    line-height: normal;
  }

  .fine-details-h1-modal.x-modal:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fine-details-h1-modal[hidden] {
    display: none !important;
  }

  .fine-details-h1-modal.x-modal .overlay {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .fine-details-h1-modal .drawer__inner {
    position: static;
    inset: auto;
    display: flex;
    flex-direction: column;
    width: calc(100% - 1.5rem);
    max-width: 46.375rem;
    height: auto;
    max-height: 90vh;
    overflow: hidden;
    background: #f6f6f6;
    color: #171717;
    border-radius: 0;
    transform: none;
  }

  @media screen and (max-width: 639px) {
    .js .fine-details-h1-modal.drawer .drawer__inner {
      inset: auto;
      width: calc(100% - 1.5rem);
      max-width: 46.375rem;
      height: auto;
      max-height: 90vh;
      border-radius: 0;
      transform: scale(0.96);
      opacity: 0;
    }

    .js .fine-details-h1-modal.drawer[active] > .drawer__inner {
      transform: none;
      opacity: 1;
    }

    .js .fine-details-h1-modal .drawer__header::before {
      content: none;
    }
  }

  .fine-details-h1-modal .drawer__header,
  .fine-details-h1-modal .drawer__content {
    opacity: 1;
    visibility: visible;
  }

  .fine-details-h1-modal__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    padding: 1.25rem 1.25rem 1.5rem;
    background: #f6f6f6;
  }

  @media screen and (min-width: 640px) {
    .fine-details-h1-modal__panel {
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }

  .fine-details-h1-modal__header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0;
    border: 0;
  }

  .fine-details-h1-modal__title {
    margin: 0;
    padding-inline-end: 2rem;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: normal;
    color: #171717;
  }

  @media screen and (min-width: 640px) {
    .fine-details-h1-modal__title {
      font-size: 2.25rem;
      line-height: 1.5;
      letter-spacing: -0.48px;
    }
  }

  .fine-details-h1-modal__text {
    margin: 0;
    max-width: 43.375rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #171717;
  }

  .fine-details-h1-modal__text p {
    margin: 0;
  }

  .fine-details-h1-modal__text p + p {
    margin-block-start: 0.5rem;
  }

  .fine-details-h1-modal__close {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }

  @media screen and (min-width: 640px) {
    .fine-details-h1-modal__close {
      top: 0.9375rem;
    }
  }

  .fine-details-h1-modal__close img {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .fine-details-h1-modal__media {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-height: 0;
  }

  .fine-details-h1-modal__media img {
    display: block;
    width: 15.625rem;
    height: 16.375rem;
    object-fit: contain;
  }

  @media screen and (min-width: 640px) {
    .fine-details-h1-modal__media img {
      width: 27.5625rem;
      height: 28.875rem;
    }
  }

  .fine-details-h1-modal__nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-block-start: auto;
  }

  .fine-details-h1-modal__nav[hidden],
  .fine-details-h1-modal__arrow[hidden] {
    display: none !important;
  }

  .fine-details-h1-modal__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .fine-details-h1-modal__arrow img {
    width: 1.75rem;
    height: 1.75rem;
    display: block;
  }

  .fine-details-h1-modal__arrow.is-next img {
    transform: scaleX(-1);
  }
</style>

{%- liquid
  assign heading = section.settings.heading | default: 'Fine details for every work trip'
  assign modal_id = 'FineDetailsModal-' | append: section.id
  assign views = section.blocks | where: 'type', 'view'
-%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  {%- if heading != blank -%}
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <h2 class="heading fine-details-h1__heading">{{ heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if views.size > 0 -%}
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <fine-details-h1 class="fine-details-h1">
        <div class="fine-details-h1__stage">
          <div class="fine-details-h1__canvas">
          {%- for view in views -%}
            {%- liquid
              assign view_image = view.settings.image
              assign view_image_mobile = view.settings.image_mobile | default: view_image
              assign popup_image = view.settings.popup_image | default: view_image
              assign popup_image_mobile = view.settings.popup_image_mobile | default: popup_image
              assign view_label = view.settings.label | default: 'Front'
              assign popup_title = view.settings.popup_title | default: view_label
              assign fallback_asset = blank
              if view.settings.view_key == 'front'
                assign fallback_asset = 'fine-details-h1-front.png'
              endif

              assign image_url = blank
              assign image_mobile_url = blank
              assign popup_image_url = blank
              assign popup_image_mobile_url = blank

              if view_image != blank
                assign image_url = view_image | image_url: width: 1600
              elsif fallback_asset != blank
                assign image_url = fallback_asset | asset_url
              endif

              if view_image_mobile != blank
                assign image_mobile_url = view_image_mobile | image_url: width: 800
              else
                assign image_mobile_url = image_url
              endif

              if popup_image != blank
                assign popup_image_url = popup_image | image_url: width: 900
              else
                assign popup_image_url = image_url
              endif

              if popup_image_mobile != blank
                assign popup_image_mobile_url = popup_image_mobile | image_url: width: 600
              else
                assign popup_image_mobile_url = popup_image_url
              endif
            -%}
            <div
              class="fine-details-h1__view"
              data-fine-details-view
              data-title="{{ popup_title | escape }}"
              data-image="{{ image_url | escape }}"
              data-image-mobile="{{ image_mobile_url | escape }}"
              data-popup-image="{{ popup_image_url | escape }}"
              data-popup-image-mobile="{{ popup_image_mobile_url | escape }}"
              data-image-alt="{{ popup_title | escape }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <div class="fine-details-h1__scene">
              <div class="fine-details-h1__media">
                {%- if view_image != blank -%}
                  <picture>
                    {%- if view.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ view_image_mobile | image_url: width: 400 }} 400w, {{ view_image_mobile | image_url: width: 800 }} 800w"
                      >
                    {%- endif -%}
                    {{- view_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200,1600', sizes: '(min-width: 768px) min(1296px, 100vw), 100vw', alt: view_label, is: 'lazy-image' -}}
                  </picture>
                {%- elsif fallback_asset != blank -%}
                  <img src="{{ fallback_asset | asset_url }}" alt="{{ view_label | escape }}" width="1031" height="1031" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>

              {%- for block in section.blocks -%}
                {%- if block.type == 'hotspot' and block.settings.view_key == view.settings.view_key -%}
                  <span
                    class="fine-details-h1__hotspot"
                    id="shopify-block-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <img src="{{ 'icon-fine-details-hotspot-h1.svg' | asset_url }}" alt="" width="118" height="118">
                  </span>
                {%- endif -%}
              {%- endfor -%}
              </div>

              <template data-fine-details-copy>
                {{ view.settings.popup_text }}
              </template>
            </div>
          {%- endfor -%}

          <div class="fine-details-h1__tabs" role="tablist" aria-label="{{ heading | escape }}">
            {%- for view in views -%}
              {%- assign view_label = view.settings.label | default: 'Front' -%}
              <button
                type="button"
                class="fine-details-h1__tab"
                role="tab"
                data-fine-details-tab
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ view.shopify_attributes }}
              >
                {{ view_label | escape }}
              </button>
            {%- endfor -%}
          </div>
          </div>
        </div>

        <x-modal
          id="{{ modal_id }}"
          class="fine-details-h1-modal x-modal drawer z-40 fixed bottom-0 left-0 h-full w-full pointer-events-none"
          role="dialog"
          aria-modal="true"
          aria-label="{{ heading | escape }}"
          hidden
        >
          <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="{{ modal_id }}" aria-expanded="false"></overlay-element>
          <div class="drawer__inner z-10">
            <div class="fine-details-h1-modal__panel">
              <div class="fine-details-h1-modal__header drawer__header">
                <h3 class="fine-details-h1-modal__title" data-fine-details-title></h3>
                <div class="fine-details-h1-modal__text rte" data-fine-details-text></div>
                <button
                  class="fine-details-h1-modal__close"
                  type="button"
                  aria-controls="{{ modal_id }}"
                  aria-expanded="false"
                  aria-label="{{ 'general.accessibility.close' | t | escape }}"
                >
                  <img src="{{ 'icon-fine-details-close-h1.svg' | asset_url }}" alt="" width="24" height="24">
                </button>
              </div>

              <div class="fine-details-h1-modal__media drawer__content">
                <img data-fine-details-image alt="" width="441" height="462">
              </div>

              <div class="fine-details-h1-modal__nav">
                <button type="button" class="fine-details-h1-modal__arrow" data-fine-details-prev aria-label="{{ 'general.pagination.previous' | t | escape }}">
                  <img src="{{ 'icon-fine-details-arrow-h1.svg' | asset_url }}" alt="" width="28" height="28">
                </button>
                <button type="button" class="fine-details-h1-modal__arrow is-next" data-fine-details-next aria-label="{{ 'general.pagination.next' | t | escape }}">
                  <img src="{{ 'icon-fine-details-arrow-h1.svg' | asset_url }}" alt="" width="28" height="28">
                </button>
              </div>
            </div>
          </div>
        </x-modal>
      </fine-details-h1>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Fine details (H1)",
  "class": "fine-details-h1-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Fine details for every work trip"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.global.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "view",
      "name": "View",
      "settings": [
        {
          "type": "select",
          "id": "view_key",
          "label": "View",
          "options": [
            {
              "value": "front",
              "label": "Front"
            },
            {
              "value": "interior",
              "label": "Interior"
            },
            {
              "value": "back",
              "label": "Back"
            }
          ],
          "default": "front"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Front"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Popup"
        },
        {
          "type": "text",
          "id": "popup_title",
          "label": "Popup title",
          "info": "Leave blank to use the button label."
        },
        {
          "type": "richtext",
          "id": "popup_text",
          "label": "Popup text",
          "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966,</p>"
        },
        {
          "type": "image_picker",
          "id": "popup_image",
          "label": "Popup image",
          "info": "Leave blank to reuse the view image."
        },
        {
          "type": "image_picker",
          "id": "popup_image_mobile",
          "label": "Popup image - mobile"
        }
      ]
    },
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "select",
          "id": "view_key",
          "label": "View",
          "options": [
            {
              "value": "front",
              "label": "Front"
            },
            {
              "value": "interior",
              "label": "Interior"
            },
            {
              "value": "back",
              "label": "Back"
            }
          ],
          "default": "front"
        },
        {
          "type": "range",
          "id": "horizontal",
          "label": "t:sections.lookbook.blocks.global.settings.horizontal.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical",
          "label": "t:sections.lookbook.blocks.global.settings.vertical.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "horizontal_mobile",
          "label": "Horizontal position - mobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
