<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
    overflow: hidden;
    isolation: isolate;
    border-end-end-radius: 0;
    border-end-start-radius: 0;
  }

  #shopify-section-{{ section.id }} .section::before {
    height: 100%;
  }

  /* Theme parks the footer under the last section (absolute + parallax).
     Keep this block in normal page flow so it does not cover footer links. */
  body.template-hreman-h1 .footer-group {
    position: relative !important;
    z-index: auto !important;
  }

  body.template-hreman-h1 [is="footer-parallax"] {
    transform: none !important;
  }

  #shopify-section-{{ section.id }} .compare-h1 {
    position: relative;
    z-index: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1 {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__heading {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 2rem;
    line-height: normal;
    letter-spacing: -0.48px;
    text-align: center;
    color: #1a1a1a;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__heading {
      font-size: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__body {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__body {
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .page-width {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .compare-h1__track {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    width: auto;
    margin-inline: calc(var(--page-padding) * -1);
    padding-inline: var(--page-padding);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .compare-h1__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__track {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr));
      gap: 1.5rem;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__card {
    display: flex;
    flex: 0 0 14.75rem;
    flex-direction: column;
    align-items: stretch;
    width: 14.75rem;
    padding: 0.75rem;
    background: #f6f6f6;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__card {
      flex: none;
      width: auto;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__inner {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__inner {
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__media {
    position: relative;
    width: 100%;
    aspect-ratio: 212 / 185;
    overflow: hidden;
    background: #f6f6f6;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__media {
      aspect-ratio: 392 / 313;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .compare-h1__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__content {
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .compare-h1__title {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.5;
    letter-spacing: -0.48px;
    text-align: center;
    color: #171717;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__title {
      font-size: 2.25rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__price {
    margin: 0;
    font-weight: 600;
    font-size: 1rem;
    line-height: normal;
    letter-spacing: -0.48px;
    text-align: center;
    color: #171717;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__price {
      font-family: var(--font-heading-family);
      font-size: 1.25rem;
      line-height: 1.5;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .compare-h1__inside {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.6875rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid rgb(23 23 23 / 0.16);
    border-radius: 0;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 500;
    line-height: normal;
    color: #171717;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .compare-h1__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.6875rem;
    padding: 0.75rem 1rem;
    background: #171717;
    border: 0;
    border-bottom: 4px solid #e4452a;
    border-right: 4px solid #e4452a;
    border-radius: 0;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    font-weight: 600;
    line-height: normal;
    color: #f6f6f6;
    text-align: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .compare-h1__cta:hover {
    background: #333;
    color: #f6f6f6;
  }

  #shopify-section-{{ section.id }} .compare-h1__specs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__specs {
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__spec {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .compare-h1__spec-label {
    font-size: 1rem;
    font-weight: 400;
    line-height: normal;
  }

  #shopify-section-{{ section.id }} .compare-h1__spec-value {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.48px;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .compare-h1__spec-value {
      font-size: 1.5rem;
      line-height: normal;
      letter-spacing: 0;
    }
  }

  #shopify-section-{{ section.id }} .compare-h1__rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid rgb(26 26 26 / 0.12);
  }

  #shopify-section-{{ section.id }} .compare-h1__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 1.4375rem;
  }

  #shopify-section-{{ section.id }} .compare-h1__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4375rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .compare-h1__badge-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.375rem;
    height: 3.375rem;
    border: 1px solid #171717;
    border-radius: 50%;
    background: rgb(var(--color-foreground) / 0.05);
  }

  #shopify-section-{{ section.id }} .compare-h1__badge-img {
    display: block;
  }

  #shopify-section-{{ section.id }} .compare-h1__badge-label {
    font-size: 1rem;
    line-height: normal;
    color: #171717;
  }
</style>

<script src="{{ 'compare-h1.js' | asset_url }}" defer="defer"></script>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    <div class="compare-h1">
      {%- if section.settings.heading != blank -%}
        <h2 class="compare-h1__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="compare-h1__body">
        {%- if section.blocks.size > 0 -%}
          <div class="compare-h1__track">
            {%- for block in section.blocks -%}
              {%- liquid
                assign card_product = block.settings.product
                assign card_index = forloop.index
                assign card_title = block.settings.heading
                if card_title == blank and card_product != blank
                  assign card_title = card_product.title
                endif
                if card_title == blank
                  assign card_title = 'Explorer Pack'
                endif

                assign card_image = block.settings.image
                if card_image == blank and card_product != blank
                  assign card_image = card_product.featured_media
                endif

                assign inside_image = block.settings.image_inside
                if inside_image == blank and card_product != blank
                  for media in card_product.media
                    if media.media_type == 'image'
                      if card_image == blank or media.id != card_image.id
                        assign inside_image = media
                        break
                      endif
                    endif
                  endfor
                endif

                assign fallback_image = 'compare-h1-1.jpg'
                if card_index == 2
                  assign fallback_image = 'compare-h1-2.jpg'
                elsif card_index == 3
                  assign fallback_image = 'compare-h1-3.jpg'
                endif

                assign spec_labels = 'Capacity,Dimensions,Weight,Water Resistance,Laptop Fit,Best for' | split: ','
                assign spec_keys = 'capacity,dimensions,weight,water_resistance,laptop_fit,best_for' | split: ','
              -%}
              <compare-card-h1 class="compare-h1__card" {{ block.shopify_attributes }}>
                <div class="compare-h1__inner">
                  <div class="compare-h1__media">
                    <div data-compare-image="outside">
                      {%- if card_image != blank -%}
                        {{- card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '236, 392, 600, 900', sizes: '(min-width: 768px) 392px, 236px', alt: card_title, is: 'lazy-image' -}}
                      {%- else -%}
                        <img src="{{ fallback_image | asset_url }}" alt="{{ card_title | escape }}" width="392" height="313" loading="lazy">
                      {%- endif -%}
                    </div>
                    {%- if inside_image != blank -%}
                      <div data-compare-image="inside" hidden>
                        {{- inside_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '236, 392, 600, 900', sizes: '(min-width: 768px) 392px, 236px', alt: card_title, is: 'lazy-image' -}}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="compare-h1__content">
                    <div class="compare-h1__intro">
                      <h3 class="compare-h1__title">{{ card_title | escape }}</h3>
                      {%- if card_product != blank -%}
                        <p class="compare-h1__price">{{ card_product.price | money_with_currency }}</p>
                      {%- elsif block.settings.price != blank -%}
                        <p class="compare-h1__price">{{ block.settings.price | escape }}</p>
                      {%- endif -%}
                      <div class="compare-h1__actions">
                        <button
                          class="compare-h1__inside"
                          type="button"
                          data-compare-inside
                          data-label-inside="{{ section.settings.show_inside_label | escape }}"
                          data-label-outside="{{ section.settings.show_outside_label | escape }}"
                          aria-pressed="false"
                        >
                          {{ section.settings.show_inside_label | escape }}
                        </button>
                        {%- if card_product != blank -%}
                          <a class="compare-h1__cta" href="{{ card_product.url }}">{{ section.settings.go_to_product_label | escape }}</a>
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="compare-h1__specs">
                      {%- assign spec_rendered = 0 -%}
                      {%- for spec_key in spec_keys -%}
                        {%- liquid
                          assign spec_value = block.settings[spec_key]
                          assign spec_label = spec_labels[forloop.index0]
                        -%}
                        {%- if spec_value != blank -%}
                          {%- if spec_rendered > 0 -%}
                            <hr class="compare-h1__rule">
                          {%- endif -%}
                          <div class="compare-h1__spec">
                            <span class="compare-h1__spec-label">{{ spec_label }}</span>
                            <span class="compare-h1__spec-value">{{ spec_value | escape }}</span>
                          </div>
                          {%- assign spec_rendered = spec_rendered | plus: 1 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              </compare-card-h1>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign has_badges = false
          if section.settings.label_1 != blank or section.settings.label_2 != blank or section.settings.label_3 != blank
            assign has_badges = true
          endif
        -%}
        {%- if has_badges -%}
          <div class="compare-h1__badges">
            {%- for i in (1..3) -%}
              {%- liquid
                assign label_key = 'label_' | append: i
                assign icon_key = 'icon_' | append: i
                assign badge_label = section.settings[label_key]
                assign badge_icon = section.settings[icon_key]
              -%}
              {%- if badge_label != blank -%}
                <div class="compare-h1__badge">
                  <span class="compare-h1__badge-circle">
                    {%- case badge_icon -%}
                      {%- when 'truck' -%}
                        <img class="compare-h1__badge-img" src="{{ 'icon-badge-truck-h1.svg' | asset_url }}" width="22" height="18" alt="" loading="lazy">
                      {%- when 'return' -%}
                        <img class="compare-h1__badge-img" src="{{ 'icon-badge-return-h1.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy">
                      {%- when 'shield' -%}
                        <img class="compare-h1__badge-img" src="{{ 'icon-badge-shield-h1.svg' | asset_url }}" width="19" height="21" alt="" loading="lazy">
                    {%- endcase -%}
                  </span>
                  <span class="compare-h1__badge-label">{{ badge_label | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Compare products (H1)",
  "class": "compare-h1-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Compare similar products"
    },
    {
      "type": "text",
      "id": "show_inside_label",
      "label": "Show inside label",
      "default": "Show Inside"
    },
    {
      "type": "text",
      "id": "show_outside_label",
      "label": "Show outside label",
      "default": "Show Outside"
    },
    {
      "type": "text",
      "id": "go_to_product_label",
      "label": "Product button label",
      "default": "Go to product"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "select",
      "id": "icon_1",
      "label": "First icon",
      "options": [
        { "value": "truck", "label": "Shipping" },
        { "value": "return", "label": "Returns" },
        { "value": "shield", "label": "Warranty" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "First label",
      "default": "Free Shipping"
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Second icon",
      "options": [
        { "value": "truck", "label": "Shipping" },
        { "value": "return", "label": "Returns" },
        { "value": "shield", "label": "Warranty" }
      ],
      "default": "return"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Second label",
      "default": "30-Day trial"
    },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Third icon",
      "options": [
        { "value": "truck", "label": "Shipping" },
        { "value": "return", "label": "Returns" },
        { "value": "shield", "label": "Warranty" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Third label",
      "default": "2-year warranty"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.global.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "info": "Leave blank to use the product title."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "info": "Used when no product is selected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_inside",
          "label": "Inside image"
        },
        {
          "type": "text",
          "id": "capacity",
          "label": "Capacity",
          "default": "25L"
        },
        {
          "type": "text",
          "id": "dimensions",
          "label": "Dimensions",
          "default": "15” × 18” × 6\""
        },
        {
          "type": "text",
          "id": "weight",
          "label": "Weight",
          "default": "14 lbs"
        },
        {
          "type": "text",
          "id": "water_resistance",
          "label": "Water resistance",
          "default": "Waterproof"
        },
        {
          "type": "text",
          "id": "laptop_fit",
          "label": "Laptop fit",
          "default": "18\""
        },
        {
          "type": "text",
          "id": "best_for",
          "label": "Best for",
          "default": "Nomads"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Compare products (H1)",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
