<script src="{{ 'faq-h1.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .faq-h1 {
    border-block-start: 1px solid rgb(var(--color-foreground) / 0.16);
  }

  #shopify-section-{{ section.id }} .faq-h1 .details {
    border-block-end: 1px solid rgb(var(--color-foreground) / 0.16);
  }

  #shopify-section-{{ section.id }} .faq-h1 .details .details__summary,
  #shopify-section-{{ section.id }} .faq-h1 .details:first-child .details__summary {
    padding-block: 1.25rem 0.625rem;
  }

  #shopify-section-{{ section.id }} .faq-h1__title {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.5;
    letter-spacing: -0.013em;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .faq-h1__plus {
    width: 1.25rem;
    height: 1.25rem;
    color: rgb(var(--color-foreground));
  }
  #shopify-section-{{ section.id }} .faq-h1__plus path {
    transition: opacity var(--animation-primary);
  }
  #shopify-section-{{ section.id }} .faq-h1 .details[aria-expanded="true"] .faq-h1__plus path[data-vertical] {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .faq-h1 .details .details__content::after {
    content: none;
  }
  #shopify-section-{{ section.id }} .faq-h1__content {
    padding-block-end: 1.25rem;
    color: rgb(var(--color-foreground));
  }
  #shopify-section-{{ section.id }} .faq-h1__content > * + * {
    margin-block-start: 1rem;
  }

  #shopify-section-{{ section.id }} .faq-h1__rte p {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .faq-h1__rte p + p {
    margin-block-start: var(--sp-6);
  }
  #shopify-section-{{ section.id }} .faq-h1__rte p br {
    display: none;
  }
  #shopify-section-{{ section.id }} .faq-h1__rte p strong {
    display: block;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .faq-h1__variant-spec {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
  }
  #shopify-section-{{ section.id }} .faq-h1__variant-spec + .faq-h1__variant-spec {
    margin-block-start: var(--sp-6);
  }
  #shopify-section-{{ section.id }} .faq-h1__variant-spec-label {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .faq-h1__variant-spec-value > * {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .faq-h1__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-base);
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .faq-h1__row svg {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .faq-h1__row + .faq-h1__row {
    margin-block-start: 1rem;
  }

  #shopify-section-{{ section.id }} .faq-h1__region-label {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1;
    margin: 0 0 0.75rem;
  }
  #shopify-section-{{ section.id }} .faq-h1__logos {
    display: flex;
    align-items: center;
    gap: 2rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-block-end: 0.75rem;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: #bfbab1 transparent;
  }
  #shopify-section-{{ section.id }} .faq-h1__logos::-webkit-scrollbar {
    height: 6px;
  }
  #shopify-section-{{ section.id }} .faq-h1__logos::-webkit-scrollbar-track {
    background: transparent;
  }
  #shopify-section-{{ section.id }} .faq-h1__logos::-webkit-scrollbar-thumb {
    background: #bfbab1;
    border-radius: 9999px;
  }
  #shopify-section-{{ section.id }} .faq-h1__logos img {
    height: var(--logo-h, 1.75rem);
    width: auto;
    max-width: none;
    flex: none;
  }

  #shopify-section-{{ section.id }} .faq-h1__disclaimer {
    font-size: var(--text-base);
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .faq-h1__disclaimer strong {
    color: #e4452a;
    font-weight: 600;
    text-decoration: underline;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .faq-h1 .details .details__summary,
    #shopify-section-{{ section.id }} .faq-h1 .details:first-child .details__summary {
      padding-block: 1.5rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__content > * + * {
      margin-block-start: 1.5rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__rte p + p {
      margin-block-start: var(--sp-6);
    }
    #shopify-section-{{ section.id }} .faq-h1__region-label {
      margin-block-end: 1.25rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__logos {
      padding-block-end: 1.25rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__title {
      font-size: 2.25rem;
      letter-spacing: -0.48px;
    }
    #shopify-section-{{ section.id }} .faq-h1__plus {
      width: 1.5rem;
      height: 1.5rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__content {
      padding-block-end: 1.5rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__rte p strong,
    #shopify-section-{{ section.id }} .faq-h1__variant-spec-label,
    #shopify-section-{{ section.id }} .faq-h1__region-label {
      font-size: 1.5rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__row svg {
      width: 2rem;
      height: 2rem;
    }
    #shopify-section-{{ section.id }} .faq-h1__logos {
      gap: 3rem;
    }
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {%- if section.blocks.size > 0 -%}
      {%- liquid
        assign has_open_item = false
      -%}
      {%- capture plus_icon -%}
        <svg class="faq-h1__plus shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M2 12H22" stroke-linecap="round"/><path data-vertical d="M12 2V22" stroke-linecap="round"/></svg>
      {%- endcapture -%}
      <div class="faq-h1 relative">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'item' -%}
              {%- if has_open_item -%}
                {%- comment %}theme-check-disable UnclosedHTMLElement{% endcomment %}
                </div></details>
                {%- comment %}theme-check-enable UnclosedHTMLElement{% endcomment %}
              {%- endif -%}
              {%- assign has_open_item = true -%}
              {%- comment %}theme-check-disable UnclosedHTMLElement{% endcomment %}
              <details class="details" is="accordion-details"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary class="details__summary flex items-center justify-between gap-4 cursor-pointer">
                  <span class="faq-h1__title">{{ block.settings.title | escape }}</span>
                  {{ plus_icon }}
                </summary>
                <div class="details__content faq-h1__content">
              {%- comment %}theme-check-enable UnclosedHTMLElement{% endcomment %}
                  {%- if block.settings.use_variant_metafields -%}
                    <faq-h1-variant-specs>
                      <div class="faq-h1__rte" data-faq-h1-variant-specs-content>
                        {%- render 'variant-specifications-h1', variant: product.selected_or_first_available_variant, fallback_content: block.settings.content -%}
                      </div>
                      {%- for variant in product.variants -%}
                        <template data-faq-h1-variant-specs-template="{{ variant.id }}">
                          {%- render 'variant-specifications-h1', variant: variant, fallback_content: block.settings.content -%}
                        </template>
                      {%- endfor -%}
                    </faq-h1-variant-specs>
                  {%- elsif block.settings.content != blank -%}
                    {%- liquid
                      assign faq_content = block.settings.content
                      assign faq_content = faq_content | replace: '</strong><br/>', '</strong>'
                      assign faq_content = faq_content | replace: '</strong><br />', '</strong>'
                      assign faq_content = faq_content | replace: '</strong><br>', '</strong>'
                    -%}
                    <div class="faq-h1__rte">{{ faq_content }}</div>
                  {%- endif -%}

            {%- when 'icon_row' -%}
              {%- if has_open_item -%}
                <div class="faq-h1__row" {{ block.shopify_attributes }}>
                  {%- render 'icon-feature-h1', icon: block.settings.icon -%}
                  {%- if block.settings.variant_fitment != blank and block.settings.variant_fitment != 'none' -%}
                    <faq-h1-variant-specs>
                      <span data-faq-h1-variant-specs-content>
                        {%- render 'variant-fitment-h1', variant: product.selected_or_first_available_variant, field: block.settings.variant_fitment, fallback_text: block.settings.text -%}
                      </span>
                      {%- for variant in product.variants -%}
                        <template data-faq-h1-variant-specs-template="{{ variant.id }}">
                          {%- render 'variant-fitment-h1', variant: variant, field: block.settings.variant_fitment, fallback_text: block.settings.text -%}
                        </template>
                      {%- endfor -%}
                    </faq-h1-variant-specs>
                  {%- else -%}
                    <span>{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'region' -%}
              {%- if has_open_item -%}
                <div class="faq-h1__region" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}
                    <p class="faq-h1__region-label">{{ block.settings.label | escape }}</p>
                  {%- endif -%}
                  <div class="faq-h1__logos">
                    {%- for i in (1..8) -%}
                      {%- assign logo_key = 'logo_' | append: i -%}
                      {%- assign logo = block.settings[logo_key] -%}
                      {%- if logo != blank -%}
                        {%- liquid
                          # Picked images carry no height of their own, so they need the same
                          # per-logo height the asset list gets from its file|height syntax.
                          # Without it every picked logo falls back to the CSS default and ends
                          # up a different size than the same artwork added as an asset.
                          assign logo_height_key = logo_key | append: '_height'
                          assign logo_h = block.settings[logo_height_key] | default: 28
                          assign logo_width = logo_h | times: logo.aspect_ratio | round
                        -%}
                        {%- capture logo_sizes -%}{{ logo_width }}px{%- endcapture -%}
                        {%- capture logo_style -%}--logo-h: {{ logo_h }}px{%- endcapture -%}
                        {{- logo | image_url: width: 480 | image_tag: loading: 'lazy', sizes: logo_sizes, widths: '160, 240, 320, 480', style: logo_style -}}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if block.settings.logos != blank -%}
                      {%- assign logo_items = block.settings.logos | split: ',' -%}
                      {%- for logo_item in logo_items -%}
                        {%- liquid
                          assign logo_parts = logo_item | strip | split: '|'
                          assign logo_file = logo_parts[0] | strip

                          # This is a text setting, so Shopify treats it as translatable content
                          # and a translator can turn the asset file names into words, which then
                          # point at assets that do not exist. Only render names that still look
                          # like an asset: an image extension, and nothing url_encode has to
                          # escape. Anything else is dropped rather than shown as a broken image.
                          assign logo_ext = logo_file | split: '.' | last | downcase
                          assign logo_is_asset = false
                          if logo_ext == 'png' or logo_ext == 'jpg' or logo_ext == 'jpeg' or logo_ext == 'svg' or logo_ext == 'webp' or logo_ext == 'gif'
                            assign logo_encoded = logo_file | url_encode
                            unless logo_encoded contains '%'
                              assign logo_is_asset = true
                            endunless
                          endif
                        -%}
                        {%- if logo_is_asset -%}
                          {%- assign logo_h = logo_parts[1] | strip | default: 28 -%}
                          {%- assign logo_alt = logo_file | remove: 'airline-' | remove: '-h1' | split: '.' | first | replace: '-', ' ' | capitalize -%}
                          {%- comment %}theme-check-disable ImgWidthAndHeight{% endcomment %}
                          <img src="{{ logo_file | asset_url }}" alt="{{ logo_alt | escape }}" loading="lazy" style="--logo-h: {{ logo_h }}px">
                          {%- comment %}theme-check-enable ImgWidthAndHeight{% endcomment %}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'disclaimer' -%}
              {%- if has_open_item -%}
                <p class="faq-h1__disclaimer" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}<strong>{{ block.settings.label | escape }}</strong> {% endif -%}
                  {{- block.settings.text | escape -}}
                </p>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if has_open_item -%}
          {%- comment %}theme-check-disable UnclosedHTMLElement{% endcomment %}
          </div></details>
          {%- comment %}theme-check-enable UnclosedHTMLElement{% endcomment %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion (H1)",
  "class": "faq-h1-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Accordion with rich content. Add an Item, then place Icon row, Airline logos, and Disclaimer blocks below it to fill that item."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.global.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.global.settings.heading.label",
          "default": "Size and Features"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Bold the label, then the value. Spacing after labels is handled in CSS — do not add blank lines or extra line breaks after Capacity, Max Laptop Carry, and similar labels."
        },
        {
          "type": "checkbox",
          "id": "use_variant_metafields",
          "label": "Use selected variant specifications",
          "info": "Uses custom.capacity, custom.dimensions, and custom.weight from the selected variant. Falls back to Content when none are set.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "icon_row",
      "name": "Icon row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "laptop", "label": "Laptop" },
            { "value": "tablet", "label": "Tablet" },
            { "value": "lake", "label": "Water resistant" },
            { "value": "expand", "label": "Expandable" },
            { "value": "shield", "label": "Shield" },
            { "value": "circle-lock", "label": "Lock" }
          ],
          "default": "laptop"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.global.settings.text.label",
          "default": "Fits laptops up to 16 inch displays"
        },
        {
          "type": "select",
          "id": "variant_fitment",
          "label": "Selected variant fitment",
          "info": "Reads a single-line variant metafield. Text is the fallback when that field is empty.",
          "options": [
            { "value": "none", "label": "Use Text" },
            { "value": "laptop_fitment", "label": "Laptop: custom.laptop_fitment" },
            { "value": "tablet_fitment", "label": "Tablet: custom.tablet_fitment" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "region",
      "name": "Airline logos",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Region label",
          "default": "Europe"
        },
        { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
        { "type": "range", "id": "logo_1_height", "label": "Logo 1 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
        { "type": "range", "id": "logo_2_height", "label": "Logo 2 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
        { "type": "range", "id": "logo_3_height", "label": "Logo 3 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
        { "type": "range", "id": "logo_4_height", "label": "Logo 4 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
        { "type": "range", "id": "logo_5_height", "label": "Logo 5 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_6", "label": "Logo 6" },
        { "type": "range", "id": "logo_6_height", "label": "Logo 6 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_7", "label": "Logo 7" },
        { "type": "range", "id": "logo_7_height", "label": "Logo 7 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        { "type": "image_picker", "id": "logo_8", "label": "Logo 8" },
        { "type": "range", "id": "logo_8_height", "label": "Logo 8 height", "min": 12, "max": 80, "step": 1, "unit": "px", "default": 28 },
        {
          "type": "textarea",
          "id": "logos",
          "label": "Logos from theme assets",
          "info": "Comma-separated asset file names, optionally with a display height, e.g. airline-lufthansa-h1.png|28. Rendered after the picked images. Do not translate this field in Translate & Adapt: these are file names, not copy, and translated names are skipped."
        }
      ]
    },
    {
      "type": "disclaimer",
      "name": "Disclaimer",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Disclaimer:"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.global.settings.text.label",
          "default": "Weight compliance may vary based on how much you're carrying, check with your airline to learn the latest weight allowance."
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "FAQ accordion (H1)",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Size and Features"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Laptop Fitment"
          }
        },
        {
          "type": "icon_row",
          "settings": {
            "icon": "laptop",
            "text": "Fits laptops up to 16 inch displays"
          }
        },
        {
          "type": "icon_row",
          "settings": {
            "icon": "tablet",
            "text": "Fits tablets up to 12.9 inch displays"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Cabin Luggage Compliance"
          }
        },
        {
          "type": "region",
          "settings": {
            "label": "Europe"
          }
        },
        {
          "type": "disclaimer",
          "settings": {}
        },
        {
          "type": "item",
          "settings": {
            "title": "Warranty / Shipping / Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
