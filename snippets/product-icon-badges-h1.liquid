{%- doc -%}
  Herman H1 icon badges row: circular outlined icons with labels beneath
  (e.g. Free Shipping / 30-Day trial / 2-year warranty).

  Figma: 54px circles, light "Forground" fill, 1px black stroke, 24px line icon,
  16px label, 23px gap, row centered.

  @param {object} block - icon_badges block with icon_N / label_N settings
  @param {string} section_id - Section identifier

  @example
  {% render 'product-icon-badges-h1', block: block, section_id: section.id %}
{%- enddoc -%}

<style>
  .icon-badges-h1 {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.4375rem;
    padding-block: 0.5rem;
  }

  .icon-badges-h1__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    text-align: center;
  }

  .icon-badges-h1__circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.375rem;
    height: 3.375rem;
    border-radius: 50%;
    background: rgb(var(--color-foreground) / 0.05);
    border: 1px solid #171717;
  }

  .icon-badges-h1__circle .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon-badges-h1__img {
    display: block;
  }

  .icon-badges-h1__label {
    font-size: var(--text-base);
    line-height: 1.3;
    color: rgb(var(--color-foreground));
  }
</style>

<div class="icon-badges-h1" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- liquid
      assign label_key = 'label_' | append: i
      assign icon_key = 'icon_' | append: i
      assign badge_label = block.settings[label_key]
      assign badge_icon = block.settings[icon_key]
    -%}
    {%- if badge_label != blank and badge_icon != blank -%}
      <div class="icon-badges-h1__item">
        <span class="icon-badges-h1__circle">
          {%- case badge_icon -%}
            {%- when 'truck' -%}
              <img class="icon-badges-h1__img" src="{{ 'icon-badge-truck-h1.svg' | asset_url }}" width="22" height="18" alt="" loading="lazy">
            {%- when 'return' -%}
              <img class="icon-badges-h1__img" src="{{ 'icon-badge-return-h1.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy">
            {%- when 'shield' -%}
              <img class="icon-badges-h1__img" src="{{ 'icon-badge-shield-h1.svg' | asset_url }}" width="19" height="21" alt="" loading="lazy">
            {%- else -%}
              {%- render 'icon-guarantee', icon: badge_icon, size: 'custom', width: 24, class: 'stroke-1' -%}
          {%- endcase -%}
        </span>
        <span class="icon-badges-h1__label">{{ badge_label | escape }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
