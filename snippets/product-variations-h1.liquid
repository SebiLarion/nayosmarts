{%- doc -%}
  Herman H1 color variations row: "Color: Value" label above rounded-square swatches
  linking sibling products through a shared metafield, with dividers above and below.

  Swatch source follows the block settings like the theme's product-variants snippet:
  variant featured image, metafield swatch, swatch config, or a color fallback.

  @param {object} product - Current product object
  @param {object} block - product_variations block
  @param {string} section_id - Section identifier
  @param {string} product_id - Product identifier

  @example
  {% render 'product-variations-h1',
    product: product,
    block: block,
    section_id: section.id,
    product_id: product.id
  %}
{%- enddoc -%}

{%- liquid
  assign contains_product = false
  for product_variation in block.settings.products
    if product_variation == product
      assign contains_product = true
      break
    endif
  endfor
-%}

{%- if contains_product -%}
  {%- liquid
    assign metafield_parts = block.settings.option_value_metafield | split: '.'
    assign metafield_namespace = metafield_parts | first
    assign metafield_key = metafield_parts | last
    assign current_value = product.metafields[metafield_namespace][metafield_key].value

    assign option_label = block.settings.option_name
    if option_label == blank
      assign option_label = 'products.general.color_swatch_trigger' | t
    endif
  -%}

  <style>
    .product-variations-h1 {
      display: grid;
      gap: 1rem;
    }

    .product-variations-h1__label {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
      font-size: 1rem;
      line-height: 1.2;
      color: #171717;
    }

    .product-variations-h1__label strong {
      font-weight: 600;
    }

    .product-variations-h1__label span {
      font-weight: 400;
    }

    .product-variations-h1__swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .product-variations-h1__swatch {
      display: block;
      box-sizing: border-box;
      width: 3.875rem;
      height: 3.875rem;
      padding: 0.3125rem;
      border: 0;
      border-radius: 0.375rem;
      background-color: var(--swatch-background, rgb(var(--color-foreground) / 0.1));
      background-image: var(--swatch-background-image, none);
      background-size: cover;
      background-position: center;
      background-origin: content-box;
      background-clip: content-box;
      transition: box-shadow var(--animation-short, 0.2s ease);
    }

    .product-variations-h1__swatch[aria-current='true'] {
      box-shadow: inset 0 0 0 2px #171717;
    }

    .product-variations-h1__swatch:hover:not([aria-current='true']) {
      box-shadow: inset 0 0 0 2px rgb(23 23 23 / 0.35);
    }

    .product-variations-h1__swatch.is-unavailable {
      opacity: 0.4;
    }
  </style>

  <div class="product-variations-h1" data-section-id="{{ section_id }}" {{ block.shopify_attributes }}>
    <p class="product-variations-h1__label">
      <strong>{{ option_label | escape }}:</strong>
      <span>{{ current_value | escape }}</span>
    </p>

    <ul class="product-variations-h1__swatches" role="list" aria-label="{{ option_label | escape }}">
      {%- for product_variation in block.settings.products -%}
        {%- assign value = product_variation.metafields[metafield_namespace][metafield_key].value -%}
        {%- liquid
          # The SEO title metafield is only readable in the default locale, so on a
          # translated storefront it would swap the tab title to English. The product
          # title is translated, so prefer it everywhere else.
          assign variation_page_title = blank
          if request.locale.primary
            assign variation_page_title = product_variation.metafields.global.title_tag
          endif
          assign variation_page_title = variation_page_title | default: product_variation.title

          unless variation_page_title contains shop.name
            assign variation_page_title = variation_page_title | append: ' – ' | append: shop.name
          endunless
        -%}
        {%- liquid
          assign use_variant_image = false
          if block.settings.color_swatch_type == 'variant'
            assign use_variant_image = true
          endif
        -%}
        {%- capture swatch_style -%}
          {%- render 'h1-color-swatch-style',
            swatch_product: product_variation,
            swatch_value: value,
            use_variant_image: use_variant_image
          -%}
        {%- endcapture -%}
        {%- assign swatch_style = swatch_style | strip -%}
        <li>
          <a
            href="{{ product_variation.url }}"
            class="product-variations-h1__swatch{% if swatch_style contains '--swatch-background-image' %} with-image{% endif %}{% unless product_variation.available %} is-unavailable{% endunless %}"
            title="{{ value | escape }}"
            data-color-swap
            data-product-url="{{ product_variation.url }}"
            data-color="{{ value | escape }}"
            data-page-title="{{ variation_page_title | escape }}"
            {% if product_variation == product %}aria-current="true"{% endif %}
            style="{{ swatch_style }}"
          >
            <span class="sr-only">{{ value | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <script type="application/json" data-color-swap-variant-map>
      [
        {%- for product_variation in block.settings.products -%}
          {
            "url": {{ product_variation.url | json }},
            "optionNames": {{ product_variation.options | json }},
            "variants": [
              {%- for variant in product_variation.variants -%}
                {
                  "id": {{ variant.id | json }},
                  "available": {{ variant.available | json }},
                  "options": {{ variant.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </div>
{%- endif -%}
