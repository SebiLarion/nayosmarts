{%- doc -%}
  Compact Judge.me rating row for the H1 product info: stars, score, and an underlined review count that jumps to the reviews section.

  @param {object} product - Product with Judge.me or Shopify review metafields
  @param {object} [block] - Optional section block for theme editor attributes

  @example
  {% render 'reviews-badge-h1', product: product, block: block %}
{%- enddoc -%}

{%- liquid
  assign review_rating = 0
  assign review_count = 0
  assign badge_html = product.metafields.judgeme.badge | append: ''

  if badge_html contains "data-average-rating='"
    assign review_rating = badge_html | split: "data-average-rating='" | last | split: "'" | first | plus: 0
  elsif badge_html contains 'data-average-rating="'
    assign review_rating = badge_html | split: 'data-average-rating="' | last | split: '"' | first | plus: 0
  endif

  if badge_html contains "data-number-of-reviews='"
    assign review_count = badge_html | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
  elsif badge_html contains 'data-number-of-reviews="'
    assign review_count = badge_html | split: 'data-number-of-reviews="' | last | split: '"' | first | plus: 0
  endif

  if review_count == 0 and product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0
    assign review_rating = product.metafields.reviews.rating.value.rating
    assign review_count = product.metafields.reviews.rating_count.value
  endif

  assign rating_display = review_rating | times: 10 | round | divided_by: 10.0
  assign full_stars = review_rating | floor
  assign star_fraction = review_rating | minus: full_stars
  assign partial_star_index = full_stars | plus: 1
-%}

<style>
  .reviews-badge-h1 {
    display: block;
    max-width: 100%;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: rgb(var(--color-foreground));
  }

  .reviews-badge-h1__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.08em;
    vertical-align: middle;
    white-space: nowrap;
    font-size: 1rem;
    line-height: 1;
  }

  .reviews-badge-h1__star {
    --star-fill: 0%;
    display: inline-block;
  }

  .reviews-badge-h1__star::before {
    content: '\2605';
    background: linear-gradient(
      calc(90deg * var(--transform-logical, 1)),
      rgb(var(--color-rating)) var(--star-fill),
      rgb(var(--color-foreground) / 0.15) var(--star-fill)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .reviews-badge-h1__score,
  .reviews-badge-h1__count {
    display: inline;
    vertical-align: middle;
    white-space: normal;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .reviews-badge-h1__score {
    margin-inline-start: 0.4em;
    font-weight: 500;
  }

  .reviews-badge-h1__count {
    margin-inline-start: 0.35em;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
</style>

{%- if review_count > 0 -%}
  <div class="reviews-badge-h1" {{ block.shopify_attributes }}>
    <span
      class="reviews-badge-h1__stars"
      role="img"
      aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: rating_display, rating_max: 5 }}"
    >
      {%- for i in (1..5) -%}
        {%- liquid
          assign star_fill = 0
          if i <= full_stars
            assign star_fill = 100
          elsif i == partial_star_index
            if star_fraction >= 0.95
              assign star_fill = 100
            elsif star_fraction > 0.05
              assign star_fill = 50
            endif
          endif
        -%}
        <span class="reviews-badge-h1__star" style="--star-fill: {{ star_fill }}%;" aria-hidden="true"></span>
      {%- endfor -%}
    </span>
    <span class="reviews-badge-h1__score" aria-hidden="true">{{ rating_display }}</span>
    <a class="reviews-badge-h1__count" href="#judgeme_product_reviews">
      ({{ 'general.accessibility.star_reviews_count' | t: count: review_count }})
    </a>
  </div>

  <script>
    (function () {
      if (window.__reviewsBadgeH1Smooth) return;
      window.__reviewsBadgeH1Smooth = true;

      document.addEventListener('click', function (event) {
        var link = event.target.closest && event.target.closest('.reviews-badge-h1__count');
        if (!link) return;

        var id = (link.getAttribute('href') || '').replace('#', '');
        var target = id && document.getElementById(id);
        if (!target) return;

        event.preventDefault();

        var reduced =
          (window.theme && theme.config && theme.config.motionReduced) ||
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

        target.scrollIntoView({
          behavior: reduced ? 'auto' : 'smooth',
          block: 'start'
        });

        if (history.pushState) {
          history.pushState(null, '', '#' + id);
        }
      });
    })();
  </script>
{%- endif -%}
