{%- doc -%}
  H1 sticky add-to-bag bar with color swatches and a size dropdown.
  Hides the store-wide Essential sticky cart on this template only.

  @param {object} product - Product object
  @param {object} section - Parent product section
  @param {string} product_form_id - Add-to-cart form id

  @example
  {% render 'product-sticky-form-h1', product: product, section: section, product_form_id: product_form_id %}
{%- enddoc -%}

{%- liquid
  assign variations_block = section.blocks | where: 'type', 'product_variations' | first
  assign show_color_swatches = false
  if variations_block and variations_block.settings.products.size > 0
    for product_variation in variations_block.settings.products
      if product_variation == product
        assign show_color_swatches = true
        break
      endif
    endfor
  endif

  if show_color_swatches
    assign metafield_parts = variations_block.settings.option_value_metafield | split: '.'
    assign metafield_namespace = metafield_parts | first
    assign metafield_key = metafield_parts | last
  endif

  assign size_option = blank
  assign size_option_index = 0
  for option in product.options_with_values
    assign option_name_down = option.name | downcase
    if option_name_down == 'size' or option_name_down contains 'size'
      assign size_option = option
      assign size_option_index = forloop.index0
      break
    endif
  endfor
  if size_option == blank and product.has_only_default_variant == false
    assign size_option = product.options_with_values.first
    assign size_option_index = 0
  endif
-%}

<script src="{{ 'product-sticky-form-h1.js' | asset_url }}" defer="defer"></script>

<style>
  .template-hreman-h1 #sticky-cart-portal,
  .template-hreman-h1 [data-essential-cart-element='essential-sticky-cart-container'] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    letter-spacing: var(--font-body-letter-spacing);
    color: #171717;
    background: transparent;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__card {
    background: #fff;
    background-color: #fff;
    border-block-start: 1px solid rgb(23 23 23 / 0.12);
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__card::before {
    background: #fff;
    background-color: #fff;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__variant {
    grid-template-columns: minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__media {
    display: none;
    width: 5rem;
    height: 5rem;
    background: rgb(23 23 23 / 0.04);
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__title {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 600;
    font-style: normal;
    line-height: 1.25;
    letter-spacing: 0;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__swatch {
    display: block;
    box-sizing: border-box;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.1875rem;
    border: 0;
    border-radius: 0.25rem;
    background-color: var(--swatch-background, rgb(23 23 23 / 0.1));
    background-image: var(--swatch-background-image, none);
    background-size: cover;
    background-position: center;
    background-origin: content-box;
    background-clip: content-box;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__swatch[aria-current='true'] {
    box-shadow: inset 0 0 0 2px #171717;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__swatch.is-unavailable {
    opacity: 0.4;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__price,
  #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price,
  #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price__regular,
  #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price__sale,
  #shopify-section-{{ section.id }} .product-sticky-form-h1__price .money {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: #171717;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__info {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__actions {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    min-width: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__size {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__size select {
    width: 100%;
    max-width: 100%;
    min-height: 3.1875rem;
    padding: 0.75rem 2.25rem 0.75rem 0.75rem;
    border: 1px solid rgb(23 23 23 / 0.16);
    border-radius: 0;
    background: #fff;
    color: #171717;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.3;
    appearance: none;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1__size .icon {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%) rotate(180deg);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button,
  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary {
    --buttons-radius: 0;
    --buttons-border-width: 0;
    --border-opacity: 0;
    --shadow-opacity: 0;
    flex: 0 0 auto;
    width: auto;
    height: auto;
    min-width: 7.5rem;
    min-height: 3.1875rem;
    padding: 0.75rem 1rem;
    background: #171717 !important;
    color: #f6f6f6 !important;
    border: 0 !important;
    border-bottom: 4px solid #e4452a !important;
    border-right: 4px solid #e4452a !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: var(--font-body-family) !important;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    overflow: visible;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button::after,
  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary::after {
    content: none !important;
    display: none !important;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button .btn-fill,
  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary .btn-fill {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary .btn-text {
    color: inherit !important;
    font-family: inherit;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary:hover {
    background: #333333 !important;
    color: #f6f6f6 !important;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .product-sticky-form-h1 .product-form__error-message {
    padding: 0;
    background: transparent;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-sticky-form-h1 {
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      background: transparent;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__card {
      background: #fff;
      background-color: #fff;
      gap: 0.75rem;
      box-shadow: 0 -4px 16px rgb(23 23 23 / 0.08);
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__card::before {
      background: #fff;
      background-color: #fff;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__variant {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__variant.no-image {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__media {
      display: block;
      width: 3.5rem;
      height: 3.5rem;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__info {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.375rem 0.75rem;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__title {
      display: -webkit-box;
      grid-column: 1 / -1;
      overflow: hidden;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.25;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__price,
    #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price,
    #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price__regular,
    #shopify-section-{{ section.id }} .product-sticky-form-h1__price .price__sale,
    #shopify-section-{{ section.id }} .product-sticky-form-h1__price .money {
      font-size: 1rem;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__swatch {
      width: 2rem;
      height: 2rem;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1 .button,
    #shopify-section-{{ section.id }} .product-sticky-form-h1 .button--primary {
      width: auto;
      height: auto;
      min-width: 7.5rem;
      max-width: none;
      padding: 0.75rem 1rem;
    }
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-sticky-form-h1 {
      width: 38rem;
      inset-inline-end: 1.25rem;
      inset-block-end: 1.25rem;
      background: transparent;
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__card {
      padding: 1rem;
      border: 1px solid rgb(23 23 23 / 0.12);
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__variant {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__variant.no-image {
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .product-sticky-form-h1__media {
      display: block;
    }
  }
</style>

<product-sticky-form
  class="product-sticky-form product-sticky-form-h1 w-full fixed z-20 bottom-0 right-0 pointer-events-none"
  id="ProductStickyForm-{{ section.id }}-{{ product.id }}"
  form="{{ product_form_id }}"
  data-section-id="{{ section.id }}"
>
  <div class="product-sticky-form-h1__card product-sticky-form__card grid gap-4 opacity-0 invisible pointer-events-auto">
    {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
    <div class="product-sticky-form-h1__variant product-sticky-form__variant{% if featured_media == blank %} no-image{% endif %} grid items-start gap-4">
      {%- if featured_media != blank -%}
        {%- assign max_width = featured_media.width -%}
        {%- capture sizes -%}80px{%- endcapture -%}
        {%- capture widths -%}{{ 80 | times: 1.5 | at_most: max_width | round }}, {{ 80 | times: 2 | at_most: max_width }}, {{ 80 | times: 3 | at_most: max_width }}{%- endcapture -%}
        <div class="product-sticky-form-h1__media media media--adapt relative overflow-hidden" data-widths="{{ widths }}" data-sticky-product-media>
          {{- featured_media | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, is: 'lazy-image' -}}
        </div>
      {%- endif -%}

      <div class="product-sticky-form-h1__info grid gap-3 min-w-0">
        <p class="product-sticky-form-h1__title">{{ product.title }}</p>
        <div class="sr-only" data-sticky-product-options hidden>
          {{- product.selected_or_first_available_variant.title -}}
        </div>

        {%- if show_color_swatches -%}
          <ul class="product-sticky-form-h1__swatches" role="list" aria-label="{{ variations_block.settings.option_name | escape }}">
            {%- for product_variation in variations_block.settings.products -%}
              {%- assign value = product_variation.metafields[metafield_namespace][metafield_key].value -%}
              {%- liquid
                assign variation_page_title = product_variation.metafields.global.title_tag | default: product_variation.title
                unless variation_page_title contains shop.name
                  assign variation_page_title = variation_page_title | append: ' – ' | append: shop.name
                endunless

                assign swatch_image = blank
                assign swatch_fallback = value | split: ' ' | last | handle
                assign swatch_fallback_override = false

                if value.swatch != blank
                  if value.swatch.image
                    assign swatch_image = value.swatch.image | image_url: width: 128
                  elsif value.swatch.color
                    assign swatch_fallback = value.swatch.color
                    assign swatch_fallback_override = true
                  endif
                elsif settings.swatch_config != blank
                  assign value_downcase = value | downcase | strip
                  assign swatch_config = settings.swatch_config | newline_to_br | split: '<br />'
                  for swatch in swatch_config
                    assign swatch_parts = swatch | strip | split: ':'
                    assign swatch_name = swatch_parts.first | downcase | strip
                    if swatch_name == value_downcase
                      assign swatch_value = swatch_parts.last | strip
                      if swatch_value contains '#'
                        assign swatch_fallback = swatch_value
                        assign swatch_fallback_override = true
                      else
                        if images[swatch_value] != blank
                          assign swatch_image = images[swatch_value] | image_url: width: 128
                        elsif swatch_value contains '//cdn.shopify.com/'
                          assign swatch_image = swatch_value
                        endif
                      endif
                      break
                    endif
                  endfor
                endif

                if variations_block.settings.color_swatch_type == 'variant' and product_variation.featured_media
                  assign swatch_image = product_variation.featured_media | image_url: width: 128
                  assign swatch_fallback_override = false
                endif
              -%}
              <li>
                <a
                  href="{{ product_variation.url }}"
                  class="product-sticky-form-h1__swatch{% if swatch_image != blank %} with-image{% endif %}{% unless product_variation.available %} is-unavailable{% endunless %}"
                  title="{{ value | escape }}"
                  data-color-swap
                  data-product-url="{{ product_variation.url }}"
                  data-color="{{ value | escape }}"
                  data-page-title="{{ variation_page_title | escape }}"
                  {% if product_variation == product %}aria-current="true"{% endif %}
                  style="--swatch-background: {{ swatch_fallback }};{% if swatch_fallback_override == false and swatch_image != blank %}--swatch-background-image: url({{ swatch_image }});{% endif %}"
                >
                  <span class="sr-only">{{ value | escape }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="product-sticky-form-h1__price" id="StickyPrice-{{ section.id }}-{{ product.id }}">
          {%- render 'product-price', product: product, use_variant: true, class: 'flex flex-wrap items-center gap-2' -%}
        </div>
      </div>
    </div>

    {%- liquid
      assign check_against_inventory = true
      if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
        assign check_against_inventory = false
      endif
      if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
        assign quantity_rule_soldout = true
      endif

      if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
        assign add_to_cart_label = 'products.product.sold_out' | t
        assign add_to_cart_aria = 'products.product.sold_out' | t
      elsif product.template_suffix != 'pre-order'
        assign add_to_cart_label = 'products.product.add_to_cart' | t
        assign add_to_cart_aria = 'products.product.add_to_cart_label' | t: title: product.title
      else
        assign add_to_cart_label = 'products.product.pre_order' | t
        assign add_to_cart_aria = 'products.product.pre_order_label' | t: title: product.title
      endif
    -%}

    <div class="product-sticky-form-h1__actions">
      {%- if size_option != blank -%}
        <label class="product-sticky-form-h1__size">
          <span class="sr-only">{{ size_option.name | escape }}</span>
          <select
            data-sticky-size-select
            data-option-index="{{ size_option_index }}"
            aria-label="{{ size_option.name | escape }}"
          >
            {%- for value in size_option.values -%}
              {%- assign value_label = value.name | default: value -%}
              <option
                value="{{ value_label | escape }}"
                {% if size_option.selected_value == value %}selected{% endif %}
                {% unless value.available %}disabled{% endunless %}
              >
                {{ value_label | escape }}
              </option>
            {%- endfor -%}
          </select>
          {%- render 'icon', icon: 'chevron-up', size: 'sm' -%}
        </label>
      {%- endif -%}

      <button
        type="submit"
        name="add"
        form="{{ product_form_id }}"
        class="button button--primary"
        is="hover-button"
        aria-label="{{ add_to_cart_aria | escape }}"
        {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %} disabled{% endif -%}
        {%- if product.template_suffix == 'pre-order' %} data-pre-order{% endif -%}
      >
        <span class="btn-fill" data-fill></span>
        <span class="btn-text">
          <span data-sold-out="{{ 'products.product.sold_out' | t | escape }}">
            {{- add_to_cart_label -}}
          </span>
        </span>
      </button>
    </div>
    <div class="product-form__error-message alert alert--error text-sm font-medium leading-tight" role="alert" hidden></div>
  </div>
</product-sticky-form>
