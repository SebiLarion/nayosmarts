{%- doc -%}
  Renders the Herman H1 product media gallery.

  Desktop uses a 2-column grid with a visible zoom icon on each image and a Show more / Show less
  control. Mobile keeps a swipeable main image with thumbnails.

  Turntable: when the selected variant (or the product) carries the `custom.turntable_video` file
  metafield, that video is appended as the last gallery slide, matching the watch-video slide used
  for product media videos.

  @param {object} product - Shopify product object with media collection
  @param {string} product_form_id - Form ID for variant media switching
  @param {string} product_id - Product identifier for component targeting
  @param {string} section_id - Section identifier for namespacing
  @param {string} [gallery_layout] - Desktop layout ('scroll', 'thumbnail', 'columns', 'dots')
  @param {string} [mobile_layout] - Mobile layout configuration
  @param {string} [thumbnail_position] - Thumbnail placement ('beside', 'below')
  @param {boolean} [mobile_thumbnail] - Show thumbnails on mobile
  @param {string} [image_zoom] - Zoom type ('none', 'hover', 'click', 'lightbox')
  @param {string} [image_ratio] - Image aspect ratio preset
  @param {string} [image_ratio_mobile] - Mobile image ratio
  @param {boolean} [image_fill] - Crop images to fill container
  @param {boolean} [hide_variants] - Hide variant-attached images
  @param {boolean} [enable_video_autoplay] - Auto-play videos
  @param {boolean} [enable_video_looping] - Loop video playback
  @param {boolean} [first_3d_model] - Enable AR/3D viewer
  @param {object} [spinning_block] - Spinning text overlay config
  @param {number} [collapsed_media_count] - Desktop images shown before Show more
  @param {array} [gallery_custom_blocks] - Custom gallery image blocks from the section
  @param {boolean} [gallery_custom_active] - Render custom gallery blocks instead of product media
  @param {number} [gallery_custom_count] - Number of custom gallery images matching the current variant

  @example
  {% render 'product-media-gallery-h1',
     product: product,
     product_form_id: product_form_id,
     product_id: product.id,
     section_id: section.id
  %}
{%- enddoc -%}

{%- liquid
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

  assign media_count = product.media.size
  if hide_variants and media_count > 1
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  assign product_variant = product.selected_or_first_available_variant
  assign featured_media = product_variant.featured_media | default: product.featured_media
  assign collapsed_media_count = collapsed_media_count | default: 4 | plus: 0
  assign media_aspect = featured_media.aspect_ratio | default: 0.88

  assign use_custom_media = false
  if gallery_custom_active == true and gallery_custom_blocks != blank
    assign use_custom_media = true
    assign media_count = gallery_custom_count | default: 0 | plus: 0
    assign featured_media = nil
    assign media_aspect = 0.88

    for block in gallery_custom_blocks
      if block.settings.image != blank
        capture custom_block_matches
          render 'product-custom-gallery-h1-match', block: block, product: product, product_variant: product_variant
        endcapture

        if custom_block_matches contains 'true'
          assign media_aspect = block.settings.image.aspect_ratio | default: 0.88
          break
        endif
      endif
    endfor
  endif

  # Turntable video: the variant metafield wins so a spin can be limited to one colour and size
  # (for example Midnight Black 25L-30L); the product metafield is the fallback for every variant.
  assign turntable_video_media = nil
  assign turntable_video_src = ''
  assign turntable_video_poster = nil
  assign turntable_video_aspect = media_aspect
  assign turntable_video_alt = product.title

  if use_custom_media
    assign turntable_video_media = product_variant.metafields.custom.turntable_video.value | default: product.metafields.custom.turntable_video.value

    if turntable_video_media != blank
      if turntable_video_media.sources
        assign turntable_video_poster = turntable_video_media.preview_image
        assign turntable_video_aspect = turntable_video_media.aspect_ratio | default: media_aspect

        for source in turntable_video_media.sources
          if source.format == 'mp4'
            assign turntable_video_src = source.url
            break
          endif
        endfor

        if turntable_video_src == blank
          assign turntable_video_src = turntable_video_media.sources.first.url
        endif
      else
        assign turntable_video_src = turntable_video_media
      endif

      if turntable_video_src != blank
        assign media_count = media_count | plus: 1
      endif
    endif
  endif
-%}
{%- capture sizes -%}(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(100vw - 64px), 75vw{%- endcapture -%}

<script src="{{ 'product-gallery-h1.js' | asset_url }}" defer="defer"></script>

<media-gallery
  id="ProductGallery-{{ section_id }}-{{ product_id }}"
  class="product__gallery product-gallery-h1 product__gallery--{{ mobile_layout }} block w-full relative{% if media_count == 1 %} with-only1{% endif %}
  {%- if gallery_layout == 'scroll' %} xl:grid xl:items-start gap-5 h-full{% endif -%}"
  form="{{ product_form_id }}"
  aria-label="{{ 'products.media.gallery_viewer' | t | escape }}"
  role="region"
  data-animate="fade-up"
  data-immediate
>
  {%- if gallery_layout == 'scroll' -%}
    {%- if featured_media != null -%}
      {%- liquid
        assign featured_media_sizes = sizes
        unless product.has_only_default_variant
          unless product_variant.metafields.theme.gang_media.value != blank and product_variant.metafields.theme.gang_media.list?
            assign gang_media_active = false
            assign gang_connect_alt = ''
            if featured_media.alt contains '#' and hide_variants == false
              assign gang_connect_alt = featured_media.alt | split: '#' | last
              assign gang_connect_list = gang_connect_alt | split: ','
              for gang_connect_value in gang_connect_list
                assign gang_exist = false
                assign gang_connect = ''
                assign gang_option_name = ''
                assign gang_connect_item = gang_connect_value

                if gang_connect_item contains ':' and localization.language.iso_code != blank
                  assign gang_split_param = localization.language.iso_code | append: ':'
                  assign gang_connect_item = gang_connect_item | split: gang_split_param | last
                endif

                if gang_connect_item contains '_'
                  assign gang_option_name = gang_connect_item | split: '_' | first | handleize

                  for option_name in product.options
                    assign option_name_handlized = option_name | handleize | replace: '_', '-'
                    if option_name_handlized == gang_option_name
                      assign gang_exist = true
                      assign gang_connect = gang_connect_item

                      assign option_key = 'option' | append: forloop.index
                      assign current_option_value = product_variant[option_key] | handleize
                      assign current_connect = option_name_handlized | append: '_' | append: current_option_value
                      if gang_connect == current_connect
                        assign gang_media_active = true
                      endif
                      break
                    endif
                  endfor

                  if gang_exist == true
                    break
                  endif
                endif
              endfor
            endif
          endunless
        endunless
      -%}
      {%- if gang_exist != true and product_variant.metafields.theme.gang_media.value != blank and product_variant.metafields.theme.gang_media.list? and product_variant.metafields.theme.gang_media.value.count == 1 -%}
        {%- capture featured_media_sizes -%}min({{ settings.page_width }}px, 100vw){%- endcapture -%}
      {%- endif -%}
      <sticky-element class="product__preview relative overflow-hidden w-full h-full hidden xl:block lg:sticky top-0">
        <div class="product__media media flex w-full relative overflow-hidden
          {%- if hide_variants and variant_images contains featured_media.src %} product__media--variant{% endif -%}"
          data-media-type="{{ featured_media.media_type }}"
          data-media-id="{{ featured_media.id }}"
          {%- if gang_exist == true %} data-gang-option="{{ gang_option_name }}" data-gang-connect="{{ gang_connect }}"{% if gang_media_active == false %} hidden{% endif %}{% else %} data-gang-default{% endif -%}
        >
          {%- assign media_alt = featured_media.alt | default: product.title -%}
          {%- render 'media', section_id: section_id, product_id: product_id, media: featured_media, sizes: featured_media_sizes, preload: true, autoplay: enable_video_autoplay, loop: enable_video_looping, media_alt: media_alt -%}

          {%- if image_zoom != 'none' and featured_media.media_type == 'image' -%}
            <button type="button" class="product-media-h1__zoom-button" is="media-{{ image_zoom }}-button" aria-label="{{ 'products.media.open_media' | t: index: featured_media.position | escape }}" tabindex="-1">
              <span class="product-media-h1__zoom-icon" aria-hidden="true">
                <img src="{{ 'icon-product-media-zoom.svg' | asset_url }}" width="56" height="56" alt="">
              </span>
            </button>
          {%- endif -%}
        </div>
      </sticky-element>
    {%- endif -%}
  {%- endif -%}

  <div class="product__media-container flex flex-col gap-4
    {%- if gallery_layout == 'thumbnail' %} items-start{% if thumbnail_position == 'beside' %} xl:flex-row{% endif %}{% endif -%}"
  >
    <product-gallery-h1
      class="product-gallery-h1__expand relative w-full h-full"
      data-collapsed-count="{{ collapsed_media_count }}"
      data-expanded="false"
      style="--media-aspect: {{ media_aspect }};"
    >
      <div class="product-gallery-h1__viewport relative w-full h-full">
        <slider-element id="SliderGallery-{{ section_id }}-{{ product_id }}" class="slider slider--desktop slider--tablet block w-full h-full" selector=".product__media" tabindex="0">
          <div
            class="product__media-list product-gallery-h1__list flex gap-1
            {%- if gallery_layout == 'columns' %} lg:grid lg:gap-4 xl:gap-5 grid-cols-2{% endif -%}
            {%- if gallery_layout == 'scroll' %} lg:grid lg:gap-4 xl:gap-5 grid-cols-2{% endif -%}"
          >
            {%- if use_custom_media -%}
              {%- assign custom_slide_position = 1 -%}
              {%- for block in gallery_custom_blocks -%}
                {%- capture custom_block_matches -%}
                  {%- render 'product-custom-gallery-h1-match', block: block, product: product, product_variant: product_variant -%}
                {%- endcapture -%}

                {%- if custom_block_matches contains 'true' and block.settings.image != blank -%}
                  {%- liquid
                    assign custom_media = block.settings.image
                    assign custom_media_width = custom_media.width | default: 2400
                    assign media_alt = block.settings.alt | default: product.title
                    assign custom_loading = 'lazy'
                    assign custom_fetchpriority = 'auto'
                    assign custom_lazyimage = 'lazy-image'

                    if custom_slide_position == 1
                      assign custom_loading = 'eager'
                      assign custom_fetchpriority = 'high'
                      assign custom_lazyimage = nil
                    endif
                  -%}
                  <div
                    class="product__media product-media-h1 card media media--{{ image_ratio }} mobile:media--{{ image_ratio_mobile }}{% unless image_fill %} media--contain{% endunless %} flex w-full shrink-0 relative overflow-hidden"
                    data-media-type="image"
                    data-media-id="custom-{{ block.id }}"
                    style="--aspect-ratio: {{ custom_media.aspect_ratio | default: media_aspect }};"
                  >
                    {{- custom_media | image_url: width: custom_media_width | image_tag: loading: custom_loading, fetchpriority: custom_fetchpriority, sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', class: 'w-full', alt: media_alt, is: custom_lazyimage -}}

                    {%- if image_zoom != 'none' -%}
                      <button
                        type="button"
                        class="product-media-h1__zoom-button"
                        is="media-{{ image_zoom }}-button"
                        aria-label="{{ 'products.media.open_media' | t: index: custom_slide_position | escape }}"
                        tabindex="-1"
                      >
                        <span class="product-media-h1__zoom-icon" aria-hidden="true">
                          <img
                            src="{{ 'icon-product-media-zoom.svg' | asset_url }}"
                            width="56"
                            height="56"
                            alt=""
                          >
                        </span>
                      </button>
                    {%- endif -%}
                  </div>
                  {%- assign custom_slide_position = custom_slide_position | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if turntable_video_src != blank -%}
                {%- liquid
                  assign watch_label = 'products.media.watch_video' | t
                  if watch_label contains 'products.media'
                    assign watch_label = 'Watch video'
                  endif
                -%}
                <div
                  class="product__media product-media-h1 card media media--{{ image_ratio }} mobile:media--{{ image_ratio_mobile }}{% unless image_fill %} media--contain{% endunless %} flex w-full shrink-0 relative overflow-hidden"
                  data-media-type="video"
                  data-media-id="custom-turntable-video"
                  style="--aspect-ratio: {{ turntable_video_aspect }};"
                >
                  <button
                    type="button"
                    class="product-media-h1__watch"
                    data-video-modal-h1
                    data-video-src="{{ turntable_video_src | escape }}"
                    data-video-type="video"
                    {%- if turntable_video_poster != blank %}
                      data-video-poster="{{ turntable_video_poster | image_url: width: 1600 }}"
                    {%- endif %}
                    aria-haspopup="dialog"
                    aria-label="{{ watch_label | escape }}"
                  >
                    {%- if turntable_video_poster != blank -%}
                      {{- turntable_video_poster | image_url: width: turntable_video_poster.width | image_tag: loading: 'lazy', fetchpriority: 'auto', sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', class: 'w-full', alt: turntable_video_alt, is: 'lazy-image' -}}
                    {%- endif -%}
                    <span class="product-media-h1__watch-label">
                      {{ watch_label | escape }}
                      <svg class="product-media-h1__watch-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                        <path d="M8.15 6.7v6.6L13.7 10 8.15 6.7z" fill="currentColor"></path>
                      </svg>
                    </span>
                  </button>
                </div>
              {%- endif -%}
            {%- else -%}
              {%- if featured_media != null -%}
                {%- render 'product-media-h1',
                  product: product,
                  product_id: product_id,
                  section_id: section_id,
                  product_variant: product_variant,
                  media: featured_media,
                  featured_media: featured_media,
                  variant_images: variant_images,
                  hide_variants: hide_variants,
                  gallery_layout: gallery_layout,
                  image_zoom: image_zoom,
                  image_fill: image_fill,
                  image_ratio: image_ratio,
                  image_ratio_mobile: image_ratio_mobile,
                  preload: true,
                  sizes: sizes,
                  autoplay: enable_video_autoplay,
                  loop: enable_video_looping
                -%}
              {%- endif -%}

              {%- for media in product.media -%}
                {%- if media.id != featured_media.id -%}
                  {%- render 'product-media-h1',
                    product: product,
                    product_id: product_id,
                    section_id: section_id,
                    product_variant: product_variant,
                    media: media,
                    featured_media: featured_media,
                    variant_images: variant_images,
                    hide_variants: hide_variants,
                    gallery_layout: gallery_layout,
                    image_zoom: image_zoom,
                    image_fill: image_fill,
                    image_ratio: image_ratio,
                    image_ratio_mobile: image_ratio_mobile,
                    preload: false,
                    sizes: sizes,
                    autoplay: enable_video_autoplay,
                    loop: enable_video_looping
                  -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </slider-element>

        <div class="indicators hidden items-center justify-between opacity-0 z-1 absolute top-0 left-0 w-full h-full pointer-events-none">
          <button class="button button--secondary pointer-events-auto" type="button" is="previous-button" aria-controls="SliderGallery-{{ section_id }}-{{ product_id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
            </span>
          </button>
          <button class="button button--secondary pointer-events-auto" type="button" is="next-button" aria-controls="SliderGallery-{{ section_id }}-{{ product_id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
            </span>
          </button>
        </div>

        {%- if media_count > collapsed_media_count -%}
          <div class="product-gallery-h1__fade" aria-hidden="true"></div>
          <button
            type="button"
            class="product-gallery-h1__toggle"
            data-gallery-toggle
            aria-expanded="false"
          >
            <span data-label-more>{{ 'products.general.show_more' | t }}</span>
            <span data-label-less hidden>{{ 'products.general.show_less' | t }}</span>
          </button>
        {%- endif -%}
      </div>
      <dialog class="product-video-modal-h1" data-video-modal-dialog-h1 aria-label="{{ 'products.media.watch_video' | t | default: 'Watch video' }}">
        <div class="product-video-modal-h1__panel">
          <button
            type="button"
            class="product-video-modal-h1__close"
            data-video-modal-close-h1
            aria-label="{{ 'general.accessibility.close' | t | escape }}"
          >
            {%- render 'icon', icon: 'close' -%}
          </button>
          <div class="product-video-modal-h1__player" data-video-modal-player-h1></div>
        </div>
      </dialog>
    </product-gallery-h1>

    {%- if media_count > 1 -%}
      {%- if gallery_layout != 'dots' -%}
        <scroll-shadow id="SliderThumbnails-{{ section_id }}-{{ product_id }}" class="product__thumbnails{% unless mobile_thumbnail %} with-dots{% endunless %}{% if gallery_layout == 'scroll' or gallery_layout == 'columns' %} lg:hidden{% endif %} product__thumbnails--{{ thumbnail_position }} grid items-center relative w-full">
        {%- endif -%}
          <media-dots class="product__thumbnails-list scroll-area grid items-end justify-start gap-4 w-full" aria-controls="SliderGallery-{{ section_id }}-{{ product_id }}">
            {%- if use_custom_media -%}
              {%- assign custom_thumb_position = 1 -%}
              {%- for block in gallery_custom_blocks -%}
                {%- capture custom_block_matches -%}
                  {%- render 'product-custom-gallery-h1-match', block: block, product: product, product_variant: product_variant -%}
                {%- endcapture -%}

                {%- if custom_block_matches contains 'true' and block.settings.image != blank -%}
                  {%- liquid
                    assign custom_media = block.settings.image
                    assign media_alt = block.settings.alt | default: product.title
                  -%}
                  <button
                    type="button"
                    class="product__thumbnail media media--{{ image_ratio }} mobile:media--{{ image_ratio_mobile }}{% unless image_fill %} media--contain{% endunless %} relative overflow-hidden"
                    data-media-id="custom-{{ block.id }}"
                    aria-label="{{ 'general.accessibility.go_to_item' | t: index: custom_thumb_position | escape }}"
                    aria-current="{% if custom_thumb_position == 1 %}true{% else %}false{% endif %}"
                    style="--aspect-ratio: {{ custom_media.aspect_ratio | default: media_aspect }};"
                  >
                    {{- custom_media | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(max-width: 1279px) 180px, 200px', widths: '90,100,180,200,270,300,400', alt: media_alt, is: 'lazy-image' -}}
                  </button>
                  {%- assign custom_thumb_position = custom_thumb_position | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if turntable_video_src != blank -%}
                <button
                  type="button"
                  class="product__thumbnail media media--{{ image_ratio }} mobile:media--{{ image_ratio_mobile }}{% unless image_fill %} media--contain{% endunless %} relative overflow-hidden"
                  data-media-id="custom-turntable-video"
                  aria-label="{{ 'general.accessibility.go_to_item' | t: index: custom_thumb_position | escape }}"
                  aria-current="false"
                  style="--aspect-ratio: {{ turntable_video_aspect }};"
                >
                  {%- if turntable_video_poster != blank -%}
                    {{- turntable_video_poster | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(max-width: 1279px) 180px, 200px', widths: '90,100,180,200,270,300,400', alt: turntable_video_alt, is: 'lazy-image' -}}
                  {%- endif -%}
                  <span class="play-button absolute flex items-center justify-center rounded-full">
                    {%- render 'icon', icon: 'play' -%}
                  </span>
                </button>
              {%- endif -%}
            {%- else -%}
              {%- if featured_media != null -%}
                {%- render 'product-thumbnail',
                  product: product,
                  product_variant: product_variant,
                  media: featured_media,
                  featured_media: featured_media,
                  variant_images: variant_images,
                  hide_variants: hide_variants,
                  image_fill: image_fill,
                  image_ratio: image_ratio,
                  image_ratio_mobile: image_ratio_mobile,
                  position: 0
                -%}
              {%- endif -%}

              {%- for media in product.media -%}
                {%- if media.id != featured_media.id -%}
                  {%- render 'product-thumbnail',
                    product: product,
                    product_variant: product_variant,
                    media: media,
                    featured_media: featured_media,
                    variant_images: variant_images,
                    hide_variants: hide_variants,
                    image_fill: image_fill,
                    image_ratio: image_ratio,
                    image_ratio_mobile: image_ratio_mobile,
                    position: forloop.index
                  -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </media-dots>
        {%- if gallery_layout != 'dots' -%}
          <template>
            <slot></slot>
            <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
              <span class="t">{%- render 'icon', icon: 'chevron-up' -%}</span>
              <span class="b">{%- render 'icon', icon: 'chevron-down' -%}</span>
              <span class="l">{%- render 'icon', icon: 'chevron-left' -%}</span>
              <span class="r">{%- render 'icon', icon: 'chevron-right' -%}</span>
            </s>
            <style>
              :host{display:inline-block;position:relative}:host([hidden]){display:none}
              s{position:absolute;inset:0;pointer-events:none;}
              s svg{width:24px;height:auto;stroke-width:var(--icon-weight);}
              s span{position:absolute;display:grid;align-items:center;justify-items:center;background-color:rgb(var(--color-background));padding:8px;opacity:0;transition:opacity var(--animation-short);}
              s .t{inset-block-start:0;inset-inline:-5px;border-block-end:1px solid rgb(var(--color-border));opacity:var(--t);}
              s .b{inset-block-end:0;inset-inline:-5px;border-block-start:1px solid rgb(var(--color-border));opacity:var(--b);}
              s .l{inset-inline-start:0;inset-block:-5px;border-inline-end:1px solid rgb(var(--color-border));opacity:var(--l);}
              s .r{inset-inline-end:0;inset-block:-5px;border-inline-start:1px solid rgb(var(--color-border));opacity:var(--r);}
              s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
              @media screen and (max-width: 1023px) {
                s{display:none}
              }
            </style>
          </template>
        </scroll-shadow>
      {%- endif -%}
    {%- endif -%}

    {%- if first_3d_model -%}
      <button class="button icon-with-text w-full" is="hover-button" aria-label="{{ 'products.product.xr_button_label' | t }}" data-shopify-xr data-shopify-model3d-id="{{ first_3d_model.id }}" data-shopify-model3d-default-id="{{ first_3d_model.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>
        <span class="btn-fill" data-fill></span>
        <span class="btn-text">
          {%- liquid
            render 'icon', icon: '3d-model'
            echo 'products.product.xr_button' | t
          -%}
        </span>
      </button>
    {%- endif -%}
  </div>
</media-gallery>

{%- if spinning_block != blank and spinning_block.settings.text != blank -%}
  <spinning-text class="product__spinning text-xs md:text-base lg:text-lg uppercase flex items-center justify-center absolute top-0 z-10 pointer-events-none" data-string="{{ spinning_block.settings.text | escape }}" style="--char-count: {{ spinning_block.settings.text.size | plus: 1 }};">
    {%- render 'icon', icon: 'thumbs-up', class: 'absolute' -%}
