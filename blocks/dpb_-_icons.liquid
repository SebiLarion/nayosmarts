{%- comment -%}
{
  "pack_name": "Icons block",
  "pack_author": "Design Packs",
  "license": "© Design Packs. All rights reserved. This code is protected by copyright law and may not be reproduced, distributed, or used without explicit permission from the author. Shopify complies with the Digital Millennium Copyright Act (DMCA) and responds to claims of copyright infringement using DMCA procedures, which could result in the termination of your Shopify account.",
}
{%- endcomment -%}

{% comment %} Security Code - hides section when app uninstalled {% endcomment %}
{%- unless content_for_header contains 'design_packs_file.js' -%}
  {%- if request.design_mode -%}
    <div class="dsgn-pck__no-app-warning">
      <div class="dsgn-pck__no-app-warning-background">
      </div>
      <div class="dsgn-pck__no-app-warning-text dsgn-pck__rte">
        <p><strong>WARNING!</strong> This premium section will not display properly without an active subscription for <a href="https://apps.shopify.com/design-packs" target="_blank" rel="noopener nofollow">Design Packs</a>. If you need any support please email <a href="mailto:info@design-packs.com" target="_blank" rel="noopener">info@design-packs.com</a> with your questions.</p>
      </div>
    </div>
  {%- endif -%}
  {%- break -%}
{%- endunless -%}

{%- comment -%} Assign: Preview section js fix {%- endcomment -%}
{%- assign section_id = section.id | replace: '+', '' | replace: '=', '' -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id | plus: 1 -%}

{%- assign block_horizontal_setting = block.settings.horizontal_alignment | default: 'default' -%}

{%- comment -%}
  Design System integration: when the section has design_system == 'global_style'
  and the user has picked a non-custom role, apply the role class to the appropriate
  wrapper. The styleguide rule then sets `--block-heading-*` (on outer) and
  `--block-text-*` (on inner) which cascade to the descendant icon-heading / icon-text
  elements without colliding (different namespaces).
{%- endcomment -%}
{%- assign heading_role_active = false -%}
{%- if section.settings.design_system == 'global_style' and block.settings.custom_heading_name != 'custom' and block.settings.custom_heading_name != blank -%}
  {%- assign heading_role_active = true -%}
{%- endif -%}
{%- assign text_role_active = false -%}
{%- if section.settings.design_system == 'global_style' and block.settings.custom_text_name != 'custom' and block.settings.custom_text_name != blank -%}
  {%- assign text_role_active = true -%}
{%- endif -%}

{%- comment -%}
  Override flags: when true, the block's typography settings are emitted as
  --block-heading-* / --block-text-* CSS variables on the wrapper. These
  cascade to the descendant icon-heading / icon-text elements; the styleguide
  role rules read them via var(--block-*, role_default), so the user override
  wins over the role's default.
{%- endcomment -%}
{%- assign heading_override_active = false -%}
{%- if section.settings.design_system != 'global_style' or block.settings.heading_override or block.settings.custom_heading_name == 'custom' -%}
  {%- assign heading_override_active = true -%}
{%- endif -%}
{%- assign text_override_active = false -%}
{%- if section.settings.design_system != 'global_style' or block.settings.text_override or block.settings.custom_text_name == 'custom' -%}
  {%- assign text_override_active = true -%}
{%- endif -%}

{%- assign heading_color_alpha = block.settings.heading_color | color_extract: 'alpha' | default: 0 -%}
{%- assign text_color_alpha = block.settings.text_color | color_extract: 'alpha' | default: 0 -%}

{%- capture css_styles -%}
<style data-dp-css="blocks/_dpb_-_icons.liquid">

  {%- if heading_override_active and block.settings.heading_enable_custom_font and block.settings.heading_custom_font != blank -%}
    {{ block.settings.heading_custom_font | font_face: font_display: 'swap' }}
    {{ block.settings.heading_custom_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
    {{ block.settings.heading_custom_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ block.settings.heading_custom_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if text_override_active and block.settings.text_enable_custom_font and block.settings.text_custom_font != blank -%}
    {{ block.settings.text_custom_font | font_face: font_display: 'swap' }}
    {{ block.settings.text_custom_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
    {{ block.settings.text_custom_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ block.settings.text_custom_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {%- endif -%}

  [id*=preview-block] .dsgn-pck__icons {
    container-type: normal !important;
  }

  .dsgn-pck__block-id-{{ block.id }} {
    width: {{ block.settings.base_width }}%;
    max-width: {{ block.settings.max_width | remove: 'px' }}px;
    --flex-gap: {{ block.settings.gap }}px;
    --icon-text-gap: {{ block.settings.icon_gap }}px;
    display: flex;

    {%- comment -%} Heading typography overrides — written as --block-heading-* vars; cascade to icon-heading. {%- endcomment -%}
    {%- if heading_override_active -%}
      {%- if heading_color_alpha != 0 -%}
        --block-heading-color: {{ block.settings.heading_color }};
      {%- endif -%}
      {%- if block.settings.heading_enable_custom_size and block.settings.heading_size != blank -%}
        --block-heading-size: {{ block.settings.heading_size }};
      {%- endif -%}
      {%- if block.settings.heading_enable_custom_font and block.settings.heading_custom_font != blank -%}
        --block-heading-font-family: {{ block.settings.heading_custom_font.family }}, {{ block.settings.heading_custom_font.fallback_families }};
        --block-heading-font-weight: {{ block.settings.heading_custom_font.weight }};
        --block-heading-font-style: {{ block.settings.heading_custom_font.style }};
      {%- endif -%}
      {%- if block.settings.heading_enable_custom_text_style -%}
        {%- if block.settings.heading_text_weight == 'normal' -%}
          --block-heading-font-weight: normal;
        {%- elsif block.settings.heading_text_weight == 'bold' -%}
          --block-heading-font-weight: bold;
        {%- endif -%}
        {%- if block.settings.heading_text_style == 'italic' -%}
          --block-heading-font-style: italic;
        {%- elsif block.settings.heading_text_style == 'normal' -%}
          --block-heading-font-style: normal;
        {%- endif -%}
        {%- if block.settings.heading_text_transform != 'default' and block.settings.heading_text_transform != blank -%}
          --block-heading-text-transform: {{ block.settings.heading_text_transform }};
        {%- endif -%}
        {%- if block.settings.heading_letter_spacing != blank -%}
          --block-heading-letter-spacing: {{ block.settings.heading_letter_spacing }};
        {%- endif -%}
        {%- if block.settings.heading_line_height != blank -%}
          --block-heading-line-height: {{ block.settings.heading_line_height }};
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Text typography overrides — written as --block-text-* vars; cascade to icon-text. {%- endcomment -%}
    {%- if text_override_active -%}
      {%- if text_color_alpha != 0 -%}
        --block-text-color: {{ block.settings.text_color }};
      {%- endif -%}
      {%- if block.settings.text_enable_custom_size and block.settings.text_size != blank -%}
        --block-text-size: {{ block.settings.text_size }};
      {%- endif -%}
      {%- if block.settings.text_enable_custom_font and block.settings.text_custom_font != blank -%}
        --block-text-font-family: {{ block.settings.text_custom_font.family }}, {{ block.settings.text_custom_font.fallback_families }};
        --block-text-font-weight: {{ block.settings.text_custom_font.weight }};
        --block-text-font-style: {{ block.settings.text_custom_font.style }};
      {%- endif -%}
      {%- if block.settings.text_enable_custom_text_style -%}
        {%- if block.settings.text_text_weight == 'normal' -%}
          --block-text-font-weight: normal;
        {%- elsif block.settings.text_text_weight == 'bold' -%}
          --block-text-font-weight: bold;
        {%- endif -%}
        {%- if block.settings.text_text_style == 'italic' -%}
          --block-text-font-style: italic;
        {%- elsif block.settings.text_text_style == 'normal' -%}
          --block-text-font-style: normal;
        {%- endif -%}
        {%- if block.settings.text_text_transform != 'default' and block.settings.text_text_transform != blank -%}
          --block-text-text-transform: {{ block.settings.text_text_transform }};
        {%- endif -%}
        {%- if block.settings.text_letter_spacing != blank -%}
          --block-text-letter-spacing: {{ block.settings.text_letter_spacing }};
        {%- endif -%}
        {%- if block.settings.text_line_height != blank -%}
          --block-text-line-height: {{ block.settings.text_line_height }};
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- if block.settings.horizontal_alignment == 'left' -%}
      align-self: flex-start;
      margin-left: 0;
      margin-right: auto;
      --block-horizontal-alignment: flex-start;
    {%- elsif block.settings.horizontal_alignment == 'right' -%}
      align-self: flex-end;
      margin-left: auto;
      margin-right: 0;
      --block-horizontal-alignment: flex-end;
    {%- elsif block.settings.horizontal_alignment == 'center' -%}
      align-self: center;
      margin-left: auto;
      margin-right: auto;
      --block-horizontal-alignment: center;
    {%- else -%}
      margin-left: var(--block-margin-left, 0);
      margin-right: var(--block-margin-right, 0);
    {%- endif -%}
    --section-horizontal-alignment: {%- if section.settings.text_alignment == 'center' -%}center{%- elsif section.settings.text_alignment == 'right' -%}flex-end{%- endif -%};
    align-self: var(--block-horizontal-alignment, var(--section-horizontal-alignment));
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icons {
    container-type: inline-size;
    container-name: dp-icons-container;
    display: flex;
    gap: var(--flex-gap);
    flex-wrap: wrap;
    width: 100%;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
    --flex-items: {{ 100.00 | divided_by: block.settings.icon_width }};
    text-align: center;
    flex: 0 1 calc((100% / var(--flex-items)) - (((var(--flex-items) - 1) / var(--flex-items)) * var(--flex-gap)));
    width: calc((100% / var(--flex-items)) - (((var(--flex-items) - 1) / var(--flex-items)) * var(--flex-gap)));
    --icon-size: {% if block.settings.icon_size_type == 'percentage' %}{{ block.settings.image_size }}%{% else %}{{ block.settings.image_size_fixed }}px{% endif %};
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
    position: relative;
    width: var(--icon-size);
    max-width: var(--icon-size);
    height: auto;
    display: inline-block;
    font-size: 0;
  }

  .dsgn-pck__block-id-{{ block.id }} svg.dsgn-pck__svg-sizer {
    width: 100%;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-heading {
    margin-bottom: 5px;
    {%- comment -%}
      Reads --block-heading-* cascaded from the outer wrapper (set by the
      parent-class styleguide rule when a role is active, or by the icons
      block itself when override is active). Falls back to theme defaults.
    {%- endcomment -%}
    font-size: calc(var(--block-heading-size, var(--dp-g-heading-size, var(--dp-heading-size, 20px))) * {{ section.settings.text_size | default: 100 | times: 0.01 }});
    {%- if section.settings.override_theme_font != blank -%}
    font-family: var(--block-heading-font-family, var(--heading-font, inherit));
    font-weight: var(--block-heading-font-weight, var(--heading-font-weight, inherit));
    font-style: var(--block-heading-font-style, var(--heading-font-style, inherit));
    {%- else -%}
    font-family: var(--block-heading-font-family, inherit);
    font-weight: var(--block-heading-font-weight, inherit);
    font-style: var(--block-heading-font-style, inherit);
    {%- endif -%}
    color: var(--block-heading-color, inherit);
    line-height: var(--block-heading-line-height, normal);
    letter-spacing: var(--block-heading-letter-spacing, normal);
    text-transform: var(--block-heading-text-transform, none);
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__small-heading + .dsgn-pck__icon-text {
    margin-top: 5px;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-text {
    {%- comment -%}
      Reads --block-text-* cascaded from the inner .dsgn-pck__icons wrapper
      (set by the parent-class styleguide rule, or by the icons block when
      override is active). Falls back to theme defaults.
    {%- endcomment -%}
    font-size: calc(var(--block-text-size, var(--dp-g-body-size, var(--dp-body-size, 16px))) * {{ section.settings.text_size | default: 100 | times: 0.01 }});
    {%- if section.settings.override_theme_font != blank -%}
    font-family: var(--block-text-font-family, var(--main-font));
    font-weight: var(--block-text-font-weight, var(--main-font-weight));
    font-style: var(--block-text-font-style, var(--main-font-style));
    {%- else -%}
    font-family: var(--block-text-font-family, inherit);
    font-weight: var(--block-text-font-weight, inherit);
    font-style: var(--block-text-font-style, inherit);
    {%- endif -%}
    color: var(--block-text-color, inherit);
    line-height: var(--block-text-line-height, normal);
    letter-spacing: var(--block-text-letter-spacing, normal);
    text-transform: var(--block-text-text-transform, none);
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon a,
  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon p {
    color: var(--block-text-color, {{ section.settings.text_color }});
    line-height: 1.2;
    margin: 0;
    text-decoration: none;
  }

  {%- if block.settings.icon_layout == 'left' -%}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--icon-text-gap);
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
      flex: 0 0 {% if block.settings.icon_size_type == 'percentage' %}{{ block.settings.image_size }}%{% else %}{{ block.settings.image_size_fixed }}px{% endif %};
      max-width: {% if block.settings.icon_size_type == 'percentage' %}{{ block.settings.image_size }}%{% else %}{{ block.settings.image_size_fixed }}px{% endif %};
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
      flex: 1 1 auto;
      text-align: left;
    }

  {%- elsif block.settings.icon_layout == 'right' -%}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: var(--icon-text-gap);
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
      flex: 0 0 var(--icon-size);
      max-width: var(--icon-size);
      width: var(--icon-size);
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
      flex: 1 1 auto;
      text-align: right;
    }

  {%- elsif block.settings.icon_layout == 'top' -%}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: {{ block.settings.icon_gap }}px;
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
      text-align: center;
      flex: 1;
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
      flex: 0 0 auto;
      max-width: var(--icon-size);
      width: var(--icon-size);
    }

  {%- elsif block.settings.icon_layout == 'bottom' -%}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      gap: {{ block.settings.icon_gap }}px;
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
      flex: 0 0 var(--icon-size);
      max-width: var(--icon-size);
      width: var(--icon-size);
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
      text-align: center;
      flex: 1;
    }

  {%- endif -%}

  {%- if block.settings.icon_layout == 'top' or block.settings.icon_layout == 'bottom' -%}
    {%- if block.settings.icon_alignment == 'left' -%}
      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
        align-items: flex-start;
      }

      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
        text-align: left;
      }

    {%- elsif block.settings.icon_alignment == 'right' -%}
      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
        align-items: flex-end;
      }

      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
        text-align: right;
      }

    {%- endif -%}
  {%- endif -%}

  /* Custom CSS */
  {%- if block.settings.enable_custom_css == true and block.settings.custom_css != blank -%}
    {%- assign custom_css_rules = block.settings.custom_css | strip | split: '}' -%}
    {%- for rule in custom_css_rules -%}
      {%- assign clean_rule = rule | strip -%}
      {%- if clean_rule contains '{' and clean_rule != blank -%}
        {%- assign rule_parts = clean_rule | split: '{' -%}
        {%- if rule_parts.size >= 2 -%}
          {%- assign selector_part = rule_parts[0] | strip -%}
          {%- assign css_part = rule_parts[1] | strip -%}
          {%- if css_part != blank -%}
            {%- if selector_part == blank -%}
              #DP--{{ block.id }} { {{ css_part }} }
            {%- else -%}
              #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  /* Small context - small container and mobile */
  {%- capture small_context -%}
    {%- if block.settings.mobile_styles == true -%}
      .dsgn-pck__block-id-{{ block.id }} {
        --flex-gap: {{ block.settings.mobile_gap }}px;
      }

      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
        --flex-items: {{ 100.00 | divided_by: block.settings.mobile_icon_width }};
        --icon-text-gap: {{ block.settings.mobile_icon_gap }}px;
        --icon-size: {% if block.settings.mobile_icon_size_type == 'percentage' %}{{ block.settings.mobile_image_size }}%{% else %}{{ block.settings.mobile_image_size_fixed }}px{% endif %};
      }

      {%- if block.settings.mobile_icon_layout == 'left' or block.settings.mobile_icon_layout == 'right' -%}
        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
          display: flex;
          flex-direction: {% if block.settings.mobile_icon_layout == 'left' %}row{% else %}row-reverse{% endif %};
          gap: var(--icon-text-gap);
          justify-content: {{ block.settings.mobile_icon_layout }};
        }

        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
          flex: 0 0 var(--icon-size);
          max-width: var(--icon-size);
          width: var(--icon-size);
        }

        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
          flex: 1 1 auto;
          text-align: {{ block.settings.mobile_icon_layout }};
        }

      {%- elsif block.settings.mobile_icon_layout == 'top' or block.settings.mobile_icon_layout == 'bottom' -%}
        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon {
          display: flex;
          {%- if block.settings.mobile_icon_layout == 'top' -%}
            flex-direction: column;
          {%- else -%}
            flex-direction: column-reverse;
          {%- endif -%}
          align-items: center;
          gap: {{ block.settings.mobile_icon_gap }}px;
          justify-content: {{ block.settings.mobile_icon_alignment }};
        }

        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__image__wrapper {
          flex: 0 0 var(--icon-size);
          max-width: var(--icon-size);
          width: var(--icon-size);
          flex: 1;
          align-self: {% if block.settings.mobile_icon_alignment == 'left' %}flex-start{% elsif block.settings.mobile_icon_alignment == 'right' %}flex-end{% else %}center{% endif %};
        }

        .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__icon-content {
          text-align: {{ block.settings.mobile_icon_alignment }};
          flex: 1;
          width: 100%;
        }

      {%- endif -%}
      {%- comment -%}
        Mobile typography overrides — write --block-heading-size and --block-text-size
        on the wrapper at the small breakpoint. The icon-heading / icon-text rules read
        these vars and pick up the mobile values.
      {%- endcomment -%}
      .dsgn-pck__block-id-{{ block.id }} {
        {%- if heading_override_active and block.settings.heading_enable_custom_size and block.settings.mobile_heading_size != blank -%}
          --block-heading-size: {{ block.settings.mobile_heading_size }};
        {%- endif -%}
        {%- if text_override_active and block.settings.text_enable_custom_size and block.settings.mobile_text_size != blank -%}
          --block-text-size: {{ block.settings.mobile_text_size }};
        {%- endif -%}
      }
    {%- endif -%}

  /* Mobile & narrow custom CSS */
  {%- if block.settings.enable_custom_css == true and block.settings.mobile_css != blank -%}
    {%- assign mobile_css_rules = block.settings.mobile_css | strip | split: '}' -%}
    {%- for rule in mobile_css_rules -%}
      {%- assign clean_rule = rule | strip -%}
      {%- if clean_rule contains '{' and clean_rule != blank -%}
        {%- assign rule_parts = clean_rule | split: '{' -%}
        {%- if rule_parts.size >= 2 -%}
          {%- assign selector_part = rule_parts[0] | strip -%}
          {%- assign css_part = rule_parts[1] | strip -%}
          {%- if css_part != blank -%}
            {%- if selector_part == blank -%}
              #DP--{{ block.id }} { {{ css_part }} }
            {%- else -%}
              #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- endcapture -%}

  @supports (container-type: inline-size) {
    @container dp-icons-container (max-width: 300px) {
      {{ small_context }}
    }
  }

  @media (max-width: 767px) {
    {{ small_context }}
  }

  /* Hide or show on mobile and desktop */
  {%- if block.settings.hidden_on == 'mobile' -%}
    @media (max-width: 767px) {
      .dsgn-pck__block-id-{{ block.id }} {
        display: none;
      }
    }
  {%- endif -%}

  {%- if block.settings.hidden_on == 'desktop' -%}
    @media (min-width: 768px) {
      .dsgn-pck__block-id-{{ block.id }} {
        display: none;
      }
    }
  {%- endif -%}
</style>
{%- endcapture -%}

