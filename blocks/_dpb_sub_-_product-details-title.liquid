{%- comment -%}
{
  "pack_name": "Product details title block",
  "pack_author": "Design Packs",
  "license": "© Design Packs. All rights reserved. This code is protected by copyright law and may not be reproduced, distributed, or used without explicit permission from the author. Shopify complies with the Digital Millennium Copyright Act (DMCA) and responds to claims of copyright infringement using DMCA procedures, which could result in the termination of your Shopify account.",
}
{%- endcomment -%}

{% comment %} Security Code - hides section when app uninstalled {% endcomment %}
{%- unless content_for_header contains 'design_packs_file.js' -%}
  {%- if request.design_mode -%}
    <div class="dsgn-pck__no-app-warning">
      <div class="dsgn-pck__no-app-warning-background">
      </div>
      <div class="dsgn-pck__no-app-warning-text dsgn-pck__rte">
        <p><strong>WARNING!</strong> This premium section will not display properly without an active subscription for <a href="https://apps.shopify.com/design-packs" target="_blank" rel="noopener nofollow">Design Packs</a>. If you need any support please email <a href="mailto:info@design-packs.com" target="_blank" rel="noopener">info@design-packs.com</a> with your questions.</p>
      </div>
    </div>
  {%- endif -%}
  {%- break -%}
{%- endunless -%}

{%- assign block_horizontal_setting = block.settings.horizontal_alignment | default: 'default' -%}

{%- assign block_override_active = false -%}
{%- if section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' -%}
  {%- assign block_override_active = true -%}
{%- endif -%}

{%- capture css_styles -%}
  <style data-dp-css="blocks/_dpb_sub_-_product-details-title.liquid">

    [id*=preview-block] .dsgn-pck__inner-block-container {
      container-type: normal !important;
    }

    .dsgn-pck__block-id-{{ block.id }} {
      width: {{ block.settings.base_width }}%;
      max-width: {{ block.settings.max_width | remove: 'px' }}px;
      display: flex;
      {%- if section.settings.text_alignment == 'center' and block_horizontal_setting == 'default' -%}
        margin: 0 auto;
      {%- elsif section.settings.text_alignment == 'right' and block_horizontal_setting == 'default'  -%}
        margin: 0 0 0 auto;
      {%- endif -%}
      {%- if block.settings.horizontal_alignment == 'left' -%}
        align-self: flex-start;
        margin-left: 0;
        margin-right: auto;
      {%- elsif block.settings.horizontal_alignment == 'right' -%}
        align-self: flex-end;
        margin-left: auto;
        margin-right: 0;
      {%- elsif block.settings.horizontal_alignment == 'center' -%}
        align-self: center;
        margin-left: auto;
        margin-right: auto;
      {%- endif -%}
    }

    .dsgn-pck__block-id-{{ block.id }} > .dsgn-pck__inner-block-container {
      container-type: inline-size;
      container-name: dp-heading-container;
      flex: 1 1 auto;
      min-width: 0;
    }

    {%- if block_override_active and block.settings.enable_custom_font != blank -%}
      {{ block.settings.custom_font | font_face: font_display: 'swap' }}
      {{ block.settings.custom_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
      {{ block.settings.custom_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {{ block.settings.custom_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
      .dsgn-pck__block-id-{{ block.id }} {
        --custom-font: {{ block.settings.custom_font.family }}, {{ block.settings.custom_font.fallback_families }};
        --custom-font-weight: {{ block.settings.custom_font.weight }};
        --custom-font-style: {{ block.settings.custom_font.style }};
      }
    {% endif %}

    {%- if block_override_active and block.settings.highlight_enable_custom_font != blank -%}
      {{ block.settings.highlight_custom_font | font_face: font_display: 'swap' }}
      {{ block.settings.highlight_custom_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
      {{ block.settings.highlight_custom_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {{ block.settings.highlight_custom_font | font_modify: 'style', 'italic' | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
      .dsgn-pck__block-id-{{ block.id }} {
        --highlight-custom-font: {{ block.settings.highlight_custom_font.family }}, {{ block.settings.highlight_custom_font.fallback_families }};
        --highlight-custom-font-weight: {{ block.settings.highlight_custom_font.weight }};
        --highlight-custom-font-style: {{ block.settings.highlight_custom_font.style }};
      }
    {% endif %}

    {%- assign highlight_background_text_color_alpha = block.settings.highlight_background_color | color_extract: 'alpha' | default: 0 -%}
    {%- assign highlight_text_color_alpha = block.settings.highlight_text_color | color_extract: 'alpha' | default: 0 -%}
    {%- assign block_heading_alpha = block.settings.block_heading_color | color_extract: 'alpha' | default: 0 -%}
    {%- comment -%} Emit font props when the block customizes them (or the section overrides the theme font), so the tweak applies even when the styleguide role rule leaves these unconfigured. {%- endcomment -%}
    {%- assign emit_heading_font = false -%}
    {%- if section.settings.override_theme_font != blank -%}{%- assign emit_heading_font = true -%}{%- endif -%}
    {%- if block_override_active and block.settings.enable_custom_font -%}{%- assign emit_heading_font = true -%}{%- endif -%}
    {%- if block_override_active and block.settings.enable_custom_text_style -%}{%- assign emit_heading_font = true -%}{%- endif -%}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__heading {
      margin: 0;

      {%- comment -%} Set --block-heading-* vars when override is active. Styleguide role rule reads these. {%- endcomment -%}
      {%- if block_override_active and block.settings.enable_custom_font != blank -%}
        --block-heading-font-family: var(--custom-font);
        --block-heading-font-weight: var(--custom-font-weight);
        --block-heading-font-style: var(--custom-font-style);
      {%- endif -%}
      {%- if block_override_active and block_heading_alpha != 0 -%}
        --block-heading-color: {{ block.settings.block_heading_color }};
      {%- endif -%}
      {%- if block_override_active and block.settings.block_heading_size != blank and block.settings.enable_custom_heading_size == true -%}
        --block-heading-size: calc({{ block.settings.block_heading_size }} * {{ section.settings.text_size | default: 100 | times: 0.01 }});
      {%- endif -%}
      {%- if block_override_active and block.settings.enable_custom_text_style -%}
        {%- if block.settings.text_weight == 'normal' -%}
          --block-heading-font-weight: normal;
        {%- elsif block.settings.text_weight == 'bold' -%}
          --block-heading-font-weight: bold;
        {%- endif -%}
        {%- if block.settings.text_style == 'italic' -%}
          --block-heading-font-style: italic;
        {%- elsif block.settings.text_style == 'normal' -%}
          --block-heading-font-style: normal;
        {%- endif -%}
        {%- if block.settings.text_transform != 'default' -%}
          --block-heading-text-transform: {{ block.settings.text_transform }};
        {%- endif -%}
        {%- if block.settings.letter_spacing != blank -%}
          --block-heading-letter-spacing: {{ block.settings.letter_spacing }};
        {%- endif -%}
        {%- if block.settings.line_height != blank -%}
          --block-heading-line-height: {{ block.settings.line_height }};
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Property declarations read --block-heading-* with design-system / theme fallbacks. {%- endcomment -%}
      line-height: var(--block-heading-line-height, var(--dp-g-heading-line-height, var(--dp-heading-line-height, calc(3px + 2ex + 3px))));
      color: var(--block-heading-color, var(--dp-heading-color, inherit));
      font-size: var(--block-heading-size, calc(var(--dp-g-heading-size, var(--dp-heading-size, 35px)) * {{ section.settings.text_size | default: 100 | times: 0.01 }}));
      {%- if emit_heading_font -%}
        font-family: var(--block-heading-font-family, var(--heading-font));
        font-weight: var(--block-heading-font-weight, var(--heading-font-weight));
        font-style: var(--block-heading-font-style, var(--heading-font-style));
      {%- endif -%}
      {%- if block.settings.text_alignment != 'default' -%}
        text-align: {{ block.settings.text_alignment }};
      {%- else -%}
        text-align: var(--block-text-alignment, var(--section-text-alignment));
      {%- endif -%}
      {%- if block_override_active and block.settings.enable_custom_text_style -%}
        {%- if block.settings.text_transform != 'default' -%}
          text-transform: var(--block-heading-text-transform);
        {%- endif -%}
        {%- if block.settings.letter_spacing != blank -%}
          letter-spacing: var(--block-heading-letter-spacing);
        {%- endif -%}
      {%- endif -%}
    }

    {%- if block_override_active and block.settings.enable_highlighted_text -%}
      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__fancy {
        position: relative;
        {%- if block.settings.highlight_heading_size != blank or block.settings.block_heading_size != blank -%}
          --block-heading-size: calc({{ block.settings.highlight_heading_size | default: block.settings.block_heading_size }} * {{ section.settings.text_size | default: 100 | times: 0.01 }});
          font-size: calc({{ block.settings.highlight_heading_size | default: block.settings.block_heading_size }} * {{ section.settings.text_size | default: 100 | times: 0.01 }});
        {%- else -%}
          font-size: calc(var(--dp-g-heading-size, var(--dp-heading-size, 35px)) * {{ section.settings.text_size | default: 100 | times: 0.01 }});
        {%- endif -%}
        {%- if block.settings.highlight_enable_custom_font -%}
        font-family: var(--highlight-custom-font);
        font-weight: var(--highlight-custom-font-weight);
        font-style: var(--highlight-custom-font-style);
        {%- elsif section.settings.override_theme_font != blank -%}
        font-family: var(--heading-font);
        font-weight: var(--heading-font-weight);
        font-style: var(--heading-font-style);
        {%- endif -%}
        background-color: {%- if highlight_background_text_color_alpha != 0 -%}
          {{ block.settings.highlight_background_color }}
        {%- endif -%};
        color: {%- if highlight_text_color_alpha != 0 -%}
          {{ block.settings.highlight_text_color }}
        {%- endif -%};
        {%- if highlight_background_text_color_alpha != 0 -%}
          padding: 0 0.2em;
          display: inline-block;
        {%- endif -%}
      }

      {%- if block.settings.custom_highlight_css != blank -%}
        {%- assign custom_block_declarations = block.settings.custom_highlight_css | split: '}' -%}
        {%- for declaration in custom_block_declarations -%}
          {%- if declaration contains '{' -%}
            .dsgn-pck__block-id-{{ block.id }} {{ declaration }} }
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    {%- endif -%}

    /* Custom CSS */
    {%- if block.settings.enable_custom_css == true and block.settings.custom_css != blank -%}
      {%- assign custom_css_rules = block.settings.custom_css | strip | split: '}' -%}
      {%- for rule in custom_css_rules -%}
        {%- assign clean_rule = rule | strip -%}
        {%- if clean_rule contains '{' and clean_rule != blank -%}
          {%- assign rule_parts = clean_rule | split: '{' -%}
          {%- if rule_parts.size >= 2 -%}
            {%- assign selector_part = rule_parts[0] | strip -%}
            {%- assign css_part = rule_parts[1] | strip -%}
            {%- if css_part != blank -%}
              {%- if selector_part == blank -%}
                #DP--{{ block.id }} { {{ css_part }} }
              {%- else -%}
                #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    /* Small context - small container and mobile */
    {%- capture small_context -%}

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__heading {
      {%- if block_override_active and block.settings.enable_custom_heading_size -%}
        {%- if block.settings.mobile_block_heading_size != blank -%}
          --block-mobile-heading-size: calc({{ block.settings.mobile_block_heading_size }} * {{ section.settings.text_size | default: 100 | times: 0.01 }});
          font-size: var(--block-mobile-heading-size);
        {%- elsif block.settings.block_heading_size != blank -%}
          --block-mobile-heading-size: {{ block.settings.block_heading_size | remove: 'px' | times: 0.75 | round: 0 | at_least: 12 }}px;
          font-size: var(--block-mobile-heading-size);
        {%- endif -%}
      {%- endif -%}
    }

    /* Mobile & narrow custom CSS */
    {%- if block.settings.enable_custom_css == true and block.settings.mobile_css != blank -%}
      {%- assign mobile_css_rules = block.settings.mobile_css | strip | split: '}' -%}
      {%- for rule in mobile_css_rules -%}
        {%- assign clean_rule = rule | strip -%}
        {%- if clean_rule contains '{' and clean_rule != blank -%}
          {%- assign rule_parts = clean_rule | split: '{' -%}
          {%- if rule_parts.size >= 2 -%}
            {%- assign selector_part = rule_parts[0] | strip -%}
            {%- assign css_part = rule_parts[1] | strip -%}
            {%- if css_part != blank -%}
              {%- if selector_part == blank -%}
                #DP--{{ block.id }} { {{ css_part }} }
              {%- else -%}
                #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- endcapture -%}

    @supports (container-type: inline-size) {
      @container dp-heading-container (max-width: 300px) {
        {{ small_context }}
      }
    }

    @media (max-width: 767px) {
      {{ small_context }}
    }

    {%- if block.settings.hidden_on == 'mobile' -%}
      @media (max-width: 767px) {
        .dsgn-pck__block-id-{{ block.id }} {
          display: none;
        }
      }
    {%- endif -%}

    {%- if block.settings.hidden_on == 'desktop' -%}
      @media (min-width: 768px) {
        .dsgn-pck__block-id-{{ block.id }} {
          display: none;
        }
      }
    {%- endif -%}

  </style>
{%- endcapture -%}

<div id="DP--{{ block.id }}" class="DP--{{ block.id }} dsgn-pck__block dsgn-pck__block-id-{{ block.id }} dsgn-pck__block--{{ block.type }} dsgn-pck__block--{{ block.index }} dsgn-pck__block--product-title" {{ block.shopify_attributes }}>
  {{ css_styles }}
  <div class="dsgn-pck__inner-block-container">
  {%- assign display_title = block.settings.title | default: closest.product.title | default: section.settings.product.title | default: product.title | default: collections["all"].products.first.title -%}
  {%- if display_title != blank -%}
    <{{- block.settings.heading_level }} class="dsgn-pck__heading {% if section.settings.design_system == 'global_style' and block.settings.custom_style_name != 'custom' and block.settings.custom_style_name != blank %}dsgn-pck__heading-{{ block.settings.custom_style_name }}{% else %}dsgn-pck__heading-default{% endif %} dsgn-pck__product-title">
      {{ display_title | replace: '[', '<span class="dsgn-pck__fancy">' | replace: ']', '</span>' }}
    </{{- block.settings.heading_level -}}>
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Title 🎒",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Custom product title",
      "info": "Leave empty to use the product title."
    },
    {
      "visible_if": "{{ section.settings.design_system == 'global_style' }}",
      "type": "select",
      "id": "custom_style_name",
      "label": "🌈 Heading style",
      "info": "Apply style from your Design System.",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "display", "label": "Display" },
        { "value": "eyebrow", "label": "Eyebrow" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "custom-1", "label": "Custom 1" },
        { "value": "custom-2", "label": "Custom 2" },
        { "value": "custom-3", "label": "Custom 3" },
        { "value": "custom-4", "label": "Custom 4" },
        { "value": "custom-5", "label": "Custom 5" },
        { "value": "custom", "label": "None" }
      ],
      "default": "primary"
    },
    {
      "visible_if": "{{ section.settings.design_system == 'global_style' and block.settings.custom_style_name != 'custom' }}",
      "type": "checkbox",
      "id": "override",
      "label": "Tweak heading style",
      "default": false,
      "info": "Give a custom look to this individual title."
    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "color",
      "id": "block_heading_color",
      "label": "Color"
    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "enable_custom_heading_size",
      "label": "Enable custom heading size",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.enable_custom_heading_size and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "block_heading_size",
      "label": "Heading size",
      "info": "Leave empty to default to base size of 35px."
    },
    {
      "visible_if": "{{ block.settings.enable_custom_heading_size and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "mobile_block_heading_size",
      "label": "📱 Mobile & narrow display heading size",
      "info": "Leave empty to match custom heading size."
    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "enable_custom_text_style",
      "label": "Enable custom text style",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.enable_custom_text_style and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "normal", "label": "Normal" },
        { "value": "bold", "label": "Bold" }
      ]
    },
    {
      "visible_if": "{{ block.settings.enable_custom_text_style and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italic" }
      ]
    },
    {
      "visible_if": "{{ block.settings.enable_custom_text_style and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
    {
      "visible_if": "{{ block.settings.enable_custom_text_style and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "letter_spacing",
      "label": "Letter spacing"
    },
    {
      "visible_if": "{{ block.settings.enable_custom_text_style and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "line_height",
      "label": "Line height"
    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Enable custom font",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.enable_custom_font and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "font_picker",
      "id": "custom_font",
      "label": "Custom font",
      "default": "abel_n4"
    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "enable_highlighted_text",
      "label": "Enable highlighted text",
      "default": false,
      "info": "Use square brackets [] around text that you would like to highlight."
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "color",
      "id": "highlight_text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "color",
      "id": "highlight_background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "highlight_heading_size",
      "label": "Base text size",
      "placeholder": "eg. 40px",
      "info": "Set custom size for text in square brackets."
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "highlight_enable_custom_font",
      "label": "Enable custom font on selected text",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and block.settings.highlight_enable_custom_font and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "font_picker",
      "id": "highlight_custom_font",
      "label": "Custom font",
      "default": "abel_n4"
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "html",
      "id": "custom_highlight_css",
      "label": "CSS",
      "info": "Target the text in the square brackets with the class .dsgn-pck__fancy"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
