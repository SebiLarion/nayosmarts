  {% comment %} Style options  {% endcomment %}
  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock.dsgn-pck__clock--style_1 {
    border: none;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock--style_1 .dsgn-pck__measurement {
    border-left: none;
  }

  /*---*/

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock.dsgn-pck__clock--style_2 {
    border: none;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock--style_2 .dsgn-pck__measurement {
    border-left: thin solid {{ block.settings.border_color }};
  }

  /*---*/

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock.dsgn-pck__clock--style_3 {
    border: none;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock--style_3 .dsgn-pck__measurement {
    border-left: none;
    padding: 8px 16px;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock--style_3 .dsgn-pck__measurement .dsgn-pck__number {
    border-bottom: thin solid {{ block.settings.border_color }};
    margin-bottom: 12px;
  }

  /*---*/

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock.dsgn-pck__clock--style_4 {
    border: thin solid {{ block.settings.border_color }};
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__clock--style_4 .dsgn-pck__measurement {
    border-left: thin solid {{ block.settings.border_color }};
  }


  {% comment %} end Style options {% endcomment %}

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__measurement:first-child {
    border-left: none;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__number {
    width: 100%;
    text-align: center;
    padding: 5px 0;
    min-height: 2em;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__label {
    width: max-content;
    padding: 0.5em 0.8em;
  }

  /* Custom CSS */
  {%- if block.settings.enable_custom_css == true and block.settings.custom_css != blank -%}
    {%- assign custom_css_rules = block.settings.custom_css | strip | split: '}' -%}
    {%- for rule in custom_css_rules -%}
      {%- assign clean_rule = rule | strip -%}
      {%- if clean_rule contains '{' and clean_rule != blank -%}
        {%- assign rule_parts = clean_rule | split: '{' -%}
        {%- if rule_parts.size >= 2 -%}
          {%- assign selector_part = rule_parts[0] | strip -%}
          {%- assign css_part = rule_parts[1] | strip -%}
          {%- if css_part != blank -%}
            {%- if selector_part == blank -%}
              #DP--{{ block.id }} { {{ css_part }} }
            {%- else -%}
              #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  /* Small context - small container and mobile */
  {%- capture small_context -%}
  /* Mobile & narrow custom CSS */
  {%- if block.settings.enable_custom_css == true and block.settings.mobile_css != blank -%}
    {%- assign mobile_css_rules = block.settings.mobile_css | strip | split: '}' -%}
    {%- for rule in mobile_css_rules -%}
      {%- assign clean_rule = rule | strip -%}
      {%- if clean_rule contains '{' and clean_rule != blank -%}
        {%- assign rule_parts = clean_rule | split: '{' -%}
        {%- if rule_parts.size >= 2 -%}
          {%- assign selector_part = rule_parts[0] | strip -%}
          {%- assign css_part = rule_parts[1] | strip -%}
          {%- if css_part != blank -%}
            {%- if selector_part == blank -%}
              #DP--{{ block.id }} { {{ css_part }} }
            {%- else -%}
              #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- endcapture -%}

  @supports (container-type: inline-size) {
    @container dp-countdown-timer-container (max-width: 300px) {
      {{ small_context }}
    }
  }

  @media (max-width: 767px) {
    {{ small_context }}
  }

  /* Hide or show on mobile and desktop */
  {%- if block.settings.hidden_on == 'mobile' -%}
    @media (max-width: 767px) {
      .dsgn-pck__block-id-{{ block.id }} {
        display: none;
      }
    }
  {%- endif -%}

  {%- if block.settings.hidden_on == 'desktop' -%}
    @media (min-width: 768px) {
      .dsgn-pck__block-id-{{ block.id }} {
        display: none;
      }
    }
  {%- endif -%}

</style>
{%- endcapture -%}

{%- capture js_scripts -%}
  <script type="module" defer>
    /**
     * Custom element for handling countdown timer functionality
     * @extends HTMLElement
     */
    class CountdownTimer extends HTMLElement {
      constructor() {
        super();
        this.timeinterval = null;
      }

      connectedCallback() {
        this.initializeAndEnableClock();
      }

      initializeAndEnableClock() {
        const clockSelector = '.dsgn-pck__clock';
        const clockWrap = this.querySelector('.dsgn-pck__clock-wrap');
        if (!clockWrap) return;

        const startDate = clockWrap.dataset.timerStart;
        const endDate = clockWrap.dataset.timerEnd;
        const resetDaily = clockWrap.dataset.timerResetDaily === "true";
        const timezone = clockWrap.dataset.timerTimezone;
        const startMs = Date.parse(startDate);
        const endMs = Date.parse(endDate);

        function getTimezoneOffset(timezone) {
          const offsetMatch = timezone.match(/([-+]\d{2}):(\d{2})/);
          if (offsetMatch) {
            const hoursOffset = parseInt(offsetMatch[1], 10);
            const minutesOffset = parseInt(offsetMatch[2], 10);
            return hoursOffset * 60 + (hoursOffset < 0 ? -minutesOffset : minutesOffset);
          }
          return 0;
        }

        const timezoneOffset = getTimezoneOffset(timezone);

        function getCurrentMsWithTimezone() {
          const now = new Date();
          const localTime = now.getTime();
          const localOffset = now.getTimezoneOffset();
          const totalOffset = localOffset + timezoneOffset;
          return localTime + totalOffset * 60 * 1000;
        }

        const currentMs = getCurrentMsWithTimezone();

        if (endMs <= currentMs || currentMs < startMs) {
          clockWrap.style.display = 'none';
          return;
        }

        const clock = this.querySelector(clockSelector);
        let self = this;

        function updateClockDisplay(hours, minutes, seconds, days = null) {
          if (days !== null) {
            const daysSpan = clock.querySelector('.dsgn-pck__days .dsgn-pck__number');
            if (resetDaily == true){
              daysSpan.innerHTML = 0;
            } else {
              if (daysSpan.innerHTML != days) daysSpan.innerHTML = days;
            }
          }

          const hoursSpan = clock.querySelector('.dsgn-pck__hours .dsgn-pck__number');
          const minutesSpan = clock.querySelector('.dsgn-pck__minutes .dsgn-pck__number');
          const secondsSpan = clock.querySelector('.dsgn-pck__seconds .dsgn-pck__number');

          if (hoursSpan.innerHTML != hours) hoursSpan.innerHTML = ('0' + hours).slice(-2);
          if (minutesSpan.innerHTML != minutes) minutesSpan.innerHTML = ('0' + minutes).slice(-2);
          if (secondsSpan.innerHTML != seconds) secondsSpan.innerHTML = ('0' + seconds).slice(-2);
        }

        function calculateTimeLeft(targetTime) {
          const total = targetTime - getCurrentMsWithTimezone();
          const days = Math.floor(total / (1000 * 60 * 60 * 24));
          const hours = Math.floor((total / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((total / (1000 * 60)) % 60);
          const seconds = Math.floor((total / 1000) % 60);
          return { total, days, hours, minutes, seconds };
        }

        function updateClockLogic(timeLeft) {
          updateClockDisplay(timeLeft.hours, timeLeft.minutes, timeLeft.seconds, timeLeft.days);

          if (timeLeft.total <= 0) {
            clearInterval(self.timeinterval);
            if (resetDaily) {
              self.initializeAndEnableClock();
            }
          }
        }

        if (resetDaily) {
          const resetInterval = 24 * 60 * 60 * 1000;

          function getNextResetTime() {
            const lastResetTime = new Date(endMs);
            const timeSinceLastReset = getCurrentMsWithTimezone() - endMs;
            const timeUntilNextReset = resetInterval - (timeSinceLastReset % resetInterval);
            return getCurrentMsWithTimezone() + timeUntilNextReset;
          }

          function updateClock() {
            const nextResetTime = getNextResetTime();
            const timeLeft = calculateTimeLeft(nextResetTime);
            updateClockLogic(timeLeft);
          }

          updateClock();
          this.timeinterval = setInterval(updateClock, 1000);

        } else {
          function updateClock() {
            const timeLeft = calculateTimeLeft(endMs);
            updateClockLogic(timeLeft);
          }

          updateClock();
          this.timeinterval = setInterval(updateClock, 1000);
        }
      }
    }

    if (!customElements.get('dp-countdown-timer')) {
      customElements.define('dp-countdown-timer', CountdownTimer);
    }
  </script>
{%- endcapture -%}

<div id="DP--{{ block.id }}" class="DP--{{ block.id }} dsgn-pck__block dsgn-pck__block-id-{{ block.id }} dsgn-pck__block--{{ block.type }} dsgn-pck__block--{{ block.index }}" {{ block.shopify_attributes }} {% if section.settings.animation != blank %}style="--dsgn-pck-animate: {{ block_index }};"{% endif %}>
  {{ css_styles }}
  <dp-countdown-timer class="dsgn-pck__countdown-timer-container">
    {%- if block.settings.text_start_date_enabled == true -%}
      {%- if block.settings.start_date != blank -%}
        {%- assign start_date = block.settings.start_date -%}
      {%- else -%}
        {%- assign start_date = 'now' | date: '%s' -%}
      {%- endif -%}
    {%- elsif block.settings.text_start_date_enabled == false -%}
      {% capture start_date %} {{ block.settings.start_month }} {{ block.settings.start_day }} {{ block.settings.start_year }} {{ block.settings.start_time }}{% endcapture %}
    {%- endif -%}
    {%- if block.settings.text_end_date_enabled == true -%}
      {%- if block.settings.end_date != blank -%}
        {%- assign end_date = block.settings.end_date -%}
      {%- else -%}
        {%- assign end_date = 'now' | date: '%s' -%}
      {%- endif -%}
    {%- elsif block.settings.text_end_date_enabled == false -%}
      {% capture end_date %} {{ block.settings.end_month }} {{ block.settings.end_day }} {{ block.settings.end_year }} {{ block.settings.end_time }}{% endcapture %}
    {%- endif -%}
    <div class="dsgn-pck__clock-wrap"
      data-timer-start="{{ start_date }} {{ timezone }}"
      data-timer-end="{{ end_date }} {{ timezone }}"
      data-timer-reset-daily="{{ block.settings.reset_daily }}"
      data-timer-timezone="{{ block.settings.timezone }}">
        {%- assign number_class = 'dsgn-pck__number' -%}
        {%- if heading_role_active -%}
          {%- assign number_class = number_class | append: ' dsgn-pck__heading-' | append: block.settings.custom_heading_name -%}
        {%- endif -%}
        {%- assign label_class = 'dsgn-pck__label' -%}
        {%- if text_role_active -%}
          {%- assign label_class = label_class | append: ' dsgn-pck__text-' | append: block.settings.custom_text_name -%}
        {%- endif -%}
        <div class="dsgn-pck__clock dsgn-pck__grid dsgn-pck__clock--{{ block.settings.style_option }}">
          <div class="dsgn-pck__measurement dsgn-pck__days">
            <span class="{{ number_class }}">--</span>
            <span class="{{ label_class }}">{{ block.settings.days_label | default: 'days' }}</span>
          </div>
          <div class="dsgn-pck__measurement dsgn-pck__hours">
            <span class="{{ number_class }}">--</span>
            <span class="{{ label_class }}">{{ block.settings.hours_label | default: 'hours' }}</span>
          </div>
          <div class="dsgn-pck__measurement dsgn-pck__minutes">
            <span class="{{ number_class }}">--</span>
            <span class="{{ label_class }}">{{ block.settings.minutes_label | default: 'minutes' }}</span>
          </div>
          <div class="dsgn-pck__measurement dsgn-pck__seconds">
            <span class="{{ number_class }}">--</span>
            <span class="{{ label_class }} dsgn-pck__seconds-text">{{ block.settings.seconds_label | default: 'seconds' }}</span>
          </div>
        </div>
    </div>
  </dp-countdown-timer>
  {{ js_scripts }}
</div>

