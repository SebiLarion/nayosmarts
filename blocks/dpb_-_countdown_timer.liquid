  .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__measurement {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 20px;
    border-left: thin solid {{ block.settings.border_color | default: section.settings.text_color }};
