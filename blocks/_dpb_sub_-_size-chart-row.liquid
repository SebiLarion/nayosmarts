{% if block.settings.header_row == true %}
    <style>
      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__table-display__row {
        background-color: {{ block.settings.background_color }};
      }

      .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__table-display__row th {
        color: {{ block.settings.text_color }};
      }
    </style>
    <thead class="dsgn-pck__table-display__header dsgn-pck__block-id-{{ block.id }}" {{ block.shopify_attributes }}>
      <tr class="dsgn-pck__table-display__row">
        {%- for i in (1..10) -%}
          {%- capture column -%}header_column_{{ i }}{%- endcapture -%}
          <th scope="col" class="dsgn-pck__text">{{ block.settings[column] }}</th>
        {%- endfor -%}
      </tr>
    </thead>
  {%- else -%}
    {% if block.settings.highlight_row == true %}
      <style>
        .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__table-display__row {
          background-color: {{ block.settings.highlight_background_color }};
        }

        .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__table-display__row td {
          color: {{ block.settings.highlight_text_color }};
        }
      </style>
    {% endif %}
    <tr class="dsgn-pck__table-display__row dsgn-pck__block-id-{{ block.id }}" {{ block.shopify_attributes }}>
      {%- for i in (1..10) -%}
        {%- capture column -%}column_{{ i }}{%- endcapture -%}
        <td class="dsgn-pck__table-display__cell dsgn-pck__text" data-label="">
          {{ block.settings[column] | default: "&nbsp" }}
        </td>
      {%- endfor -%}
    </tr>
  {%- endif -%}

{% schema %}
