}
{%- endcomment -%}

{% comment %} Security Code - hides section when app uninstalled {% endcomment %}
{%- unless content_for_header contains 'design_packs_file.js' -%}
  {%- if request.design_mode -%}
    <div class="dsgn-pck__no-app-warning">
      <div class="dsgn-pck__no-app-warning-background">
      </div>
      <div class="dsgn-pck__no-app-warning-text dsgn-pck__rte">
        <p><strong>WARNING!</strong> This premium section will not display properly without an active subscription for <a href="https://apps.shopify.com/design-packs" target="_blank" rel="noopener nofollow">Design Packs</a>. If you need any support please email <a href="mailto:info@design-packs.com" target="_blank" rel="noopener">info@design-packs.com</a> with your questions.</p>
      </div>
    </div>
  {%- endif -%}
  {%- break -%}
{%- endunless -%}

{%- assign block_horizontal_setting = block.settings.horizontal_alignment | default: section.settings.text_alignment -%}

{%- capture css_styles -%}
<style data-dp-css="blocks/_dpb_sub_-_columns-column.liquid">

  {% if section.settings.enable_metafield_detect == true %}
    .dsgn-pck__block-id-{{ block.id }}:has(> style:only-child){
      display: none;
    }
  {% endif %}

  .dsgn-pck__block-id-{{ block.id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.background_solid }};
    background-image: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_style }} {{ block.settings.border_width }}px {{ block.settings.border_color }};
    overflow: hidden;
    {%- if block.settings.padding_type == 'custom' -%}
      padding: {{ block.settings.padding }};
    {%- elsif block.settings.padding_type == 'range' -%}
      padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    {%- else -%}
      padding: 1.2rem;
    {%- endif -%}
    {%- if block.settings.vertical_alignment == 'top' -%}
      justify-content: flex-start;
    {%- elsif block.settings.vertical_alignment == 'middle' -%}
      justify-content: center;
    {%- elsif block.settings.vertical_alignment == 'bottom' -%}
      justify-content: flex-end;
    {%- endif -%}
    {% if block.settings.enable_box_shadow %}
      box-shadow:
        {% case block.settings.card_box_shadow_intensity %}
          {% when 'subtle' %} 0 1px 4px 0 {{ block.settings.card_box_shadow_color }}33;
          {% when 'medium' %} 0 2px 8px 0 {{ block.settings.card_box_shadow_color }}55;
          {% when 'strong' %} 0 4px 16px 0 {{ block.settings.card_box_shadow_color }}88;
          {% when 'custom' %} {{ block.settings.card_box_shadow_custom_value }};
          {% else %} none;
        {% endcase %}
    {% else %}
      box-shadow: none;
    {% endif %}
    {%- comment -%} Alignment cascade: publish to children. Use own alignment if set, else fall back to the section so children always inherit a real value. {%- endcomment -%}
    {%- assign content_align = block.settings.horizontal_alignment -%}
    {%- if content_align == blank or content_align == 'default' -%}{%- assign content_align = section.settings.text_alignment -%}{%- endif -%}
    --block-horizontal-alignment: {%- if content_align == 'center' -%}center{%- elsif content_align == 'right' -%}flex-end{%- else -%}flex-start{%- endif -%};
    --block-text-alignment: {%- if content_align == 'center' -%}center{%- elsif content_align == 'right' -%}right{%- else -%}left{%- endif -%};
    --block-margin-left: {%- if content_align == 'center' or content_align == 'right' -%}auto{%- else -%}0{%- endif -%};
    --block-margin-right: {%- if content_align == 'right' -%}0{%- else -%}auto{%- endif -%};
  }

  {% if block.settings.url != blank %}
    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__full-block-link {
      z-index: -1;
    }

    .dsgn-pck__block-id-{{ block.id }} .dsgn-pck__block {
      pointer-events: none;
    }

    .dsgn-pck__block-id-{{ block.id }} a[href] {
      pointer-events: auto;
    }
  {% endif %}

  /* Column width */
  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--third {
    flex: 0 0 calc(33.333% - (var(--dp-columns-gap) * 2/3));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--two-thirds {
    flex: 0 0 calc(66.667% - (var(--dp-columns-gap) * 1/3));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--half {
    flex: 0 0 calc(50% - (var(--dp-columns-gap) * 1/2));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--fourth {
    flex: 0 0 calc(25% - (var(--dp-columns-gap) * 3/4));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--two-fourths {
    flex: 0 0 calc(50% - (var(--dp-columns-gap) * 1/2));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--three-fourths {
    flex: 0 0 calc(75% - (var(--dp-columns-gap) * 1/4));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--fifth {
    flex: 0 0 calc(20% - (var(--dp-columns-gap) * 4/5));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--two-fifths {
    flex: 0 0 calc(40% - (var(--dp-columns-gap) * 3/5));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--three-fifths {
    flex: 0 0 calc(60% - (var(--dp-columns-gap) * 2/5));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--four-fifths {
    flex: 0 0 calc(80% - (var(--dp-columns-gap) * 1/5));
  }

  .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--full {
    flex: 0 0 100%;
  }

  /* Custom CSS */
  {%- if block.settings.enable_custom_css == true and block.settings.custom_css != blank -%}
    {%- assign custom_css_rules = block.settings.custom_css | strip | split: '}' -%}
    {%- for rule in custom_css_rules -%}
      {%- assign clean_rule = rule | strip -%}
      {%- if clean_rule contains '{' and clean_rule != blank -%}
        {%- assign rule_parts = clean_rule | split: '{' -%}
        {%- if rule_parts.size >= 2 -%}
          {%- assign selector_part = rule_parts[0] | strip -%}
          {%- assign css_part = rule_parts[1] | strip -%}
          {%- if css_part != blank -%}
            {%- if selector_part == blank -%}
              #DP--{{ block.id }} { {{ css_part }} }
            {%- else -%}
              #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  /* Small context - small container and mobile */
  {%- capture small_context -%}

    /* Mobile column width */
    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--third {
      flex: 0 0 calc(33.333% - (var(--dp-columns-gap) * 2/3));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--two-thirds {
      flex: 0 0 calc(66.667% - (var(--dp-columns-gap) * 1/3));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--half {
      flex: 0 0 calc(50% - (var(--dp-columns-gap) * 1/2));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--fourth {
      flex: 0 0 calc(25% - (var(--dp-columns-gap) * 3/4));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--two-fourths {
      flex: 0 0 calc(50% - (var(--dp-columns-gap) * 1/2));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--three-fourths {
      flex: 0 0 calc(75% - (var(--dp-columns-gap) * 1/4));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--fifth {
      flex: 0 0 calc(20% - (var(--dp-columns-gap) * 4/5));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--two-fifths {
      flex: 0 0 calc(40% - (var(--dp-columns-gap) * 3/5));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--three-fifths {
      flex: 0 0 calc(60% - (var(--dp-columns-gap) * 2/5));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--four-fifths {
      flex: 0 0 calc(80% - (var(--dp-columns-gap) * 1/5));
    }

    .dsgn-pck__block-id-{{ block.id }}.dsgn-pck__grid-column--mobile--full {
      flex: 0 0 100%;
    }

    /* Mobile padding */
    {%- if block.settings.mobile_padding_type != 'default' and block.settings.mobile_styles == true -%}
      .dsgn-pck__block-id-{{ block.id }} {
        {%- if block.settings.mobile_padding_type == 'custom' -%}
          padding: {{ block.settings.mobile_padding }};
        {%- elsif block.settings.mobile_padding_type == 'range' -%}
          padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_right }}px {{ block.settings.mobile_padding_bottom }}px {{ block.settings.mobile_padding_left }}px;
        {%- else -%}
          padding: 1.2rem;
        {%- endif -%}
      }
    {%- endif -%}

    /* Mobile vertical alignment */
    {%- if block.settings.mobile_vertical_alignment != 'default' -%}
      .dsgn-pck__block-id-{{ block.id }} {
        {%- if block.settings.mobile_vertical_alignment == 'top' -%}
          justify-content: flex-start;
        {%- elsif block.settings.mobile_vertical_alignment == 'middle' -%}
          justify-content: center;
        {%- elsif block.settings.mobile_vertical_alignment == 'bottom' -%}
          justify-content: flex-end;
        {%- endif -%}
      }
    {%- endif -%}

    /* Mobile horizontal alignment */
    {%- if block.settings.mobile_horizontal_alignment != 'default' and block.settings.mobile_styles == true -%}
      .dsgn-pck__block-id-{{ block.id }} {
        --block-horizontal-alignment: {%- if block.settings.mobile_horizontal_alignment == 'left' -%}flex-start{%- elsif block.settings.mobile_horizontal_alignment == 'right' -%}flex-end{%- elsif block.settings.mobile_horizontal_alignment == 'center' -%}center{%- endif -%};
        --block-text-alignment: {%- if block.settings.mobile_horizontal_alignment == 'left' -%}left{%- elsif block.settings.mobile_horizontal_alignment == 'right' -%}right{%- elsif block.settings.mobile_horizontal_alignment == 'center' -%}center{%- endif -%};
        --block-margin-left: {%- if block.settings.mobile_horizontal_alignment == 'left' -%}0{%- else -%}auto{%- endif -%};
        --block-margin-right: {%- if block.settings.mobile_horizontal_alignment == 'right' -%}0{%- else -%}auto{%- endif -%};
      }
    {%- endif -%}

    /* Mobile & narrow custom CSS */
    {%- if block.settings.enable_custom_css == true and block.settings.mobile_css != blank -%}
      {%- assign mobile_css_rules = block.settings.mobile_css | strip | split: '}' -%}
      {%- for rule in mobile_css_rules -%}
        {%- assign clean_rule = rule | strip -%}
        {%- if clean_rule contains '{' and clean_rule != blank -%}
          {%- assign rule_parts = clean_rule | split: '{' -%}
          {%- if rule_parts.size >= 2 -%}
            {%- assign selector_part = rule_parts[0] | strip -%}
            {%- assign css_part = rule_parts[1] | strip -%}
            {%- if css_part != blank -%}
              {%- if selector_part == blank -%}
                #DP--{{ block.id }} { {{ css_part }} }
              {%- else -%}
                #DP--{{ block.id }} {{ selector_part }} { {{ css_part }} }
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  @supports (container-type: inline-size) {
    @container dp-columns-container (max-width: 300px) {
      {{ small_context }}
    }
  }

  @media (max-width: 767px) {
    {{ small_context }}
  }
</style>
{%- endcapture -%}

<div id="DP--{{ block.id }}" class="DP--{{ block.id }} dsgn-pck__block-id-{{ block.id }} dsgn-pck__grid-column dsgn-pck__grid-column--{{ block.settings.column_width }} dsgn-pck__grid-column--mobile--{{ block.settings.mobile_column_width }} dsgn-pck__grid-column--{{ block.index }}" {{ block.shopify_attributes }}>
  {% if block.settings.url != blank %}
    {%- assign link = block.settings.url -%}
    {%- liquid
      assign url_clean = link | split: '?' | first
      assign separator = '/'
      if url_clean contains '#'
        assign separator = '#'
      endif
      assign url_slug = url_clean | split: separator | last | replace: '-', ' ' | replace: '_', ' ' | strip
      assign aria_label = link.title | default: url_slug | default: link
    -%}
    <a href="{{ link }}" class="dsgn-pck__full-block-link dsgn-pck__absolute-link" aria-label="{{ aria_label | escape }}"></a>
  {% endif %}
  {{ css_styles }}
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Column",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_dpb_-_group"
    },
    {
      "type": "_dpb_sub_-_product-details-group"
    }
  ],
  "settings": [
    {
      "type": "url",
      "id": "url",
      "label": "Link",
      "info": "Link the entire column to a URL. Linked items within the column will still be clickable."
    },
    {
      "type": "select",
      "id": "column_width",
      "label": "Column width",
      "options": [
        {
          "value": "full",
          "label": "Full-width"
        },
        {
          "value": "half",
          "label": "Half-width"
        },
        {
          "group": "Thirds",
          "value": "third",
          "label": "One-third"
        },
        {
          "value": "two-thirds",
          "group": "Thirds",
          "label": "Two-thirds"
        },
        {
          "group": "Fourths",
          "value": "fourth",
          "label": "One-fourth"
        },
        {
          "group": "Fourths",
          "value": "two-fourths",
          "label": "Two-fourths"
        },
        {
          "group": "Fourths",
          "value": "three-fourths",
          "label": "Three-fourths"
        },
        {
          "group": "Fifths",
          "value": "fifth",
          "label": "One-fifth"
        },
        {
          "group": "Fifths",
          "value": "two-fifths",
          "label": "Two-fifths"
        },
        {
          "group": "Fifths",
