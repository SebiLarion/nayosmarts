    },
    {
      "visible_if": "{{ section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "enable_custom_text_style",
      "label": "Enable custom text style",
      "default": false
    },
