      "type": "text",
      "id": "highlight_heading_size",
      "label": "Highlighted text size",
      "placeholder": "eg. 40px",
      "info": "Set custom size for text in square brackets."
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "text",
      "id": "highlight_mobile_heading_size",
      "label": "📱 Mobile & narrow display highlighted text size",
      "placeholder": "eg. 40px",
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "checkbox",
      "id": "highlight_enable_custom_font",
      "label": "Enable custom font on highlighted text",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and block.settings.highlight_enable_custom_font and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "font_picker",
      "id": "highlight_custom_font",
      "label": "Highlighted text custom font",
      "default": "abel_n4"
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
