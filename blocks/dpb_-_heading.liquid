      "max": 10,
      "default": 2,
      "unit": "px"
    },
    {
      "visible_if": "{{ block.settings.enable_highlighted_text and block.settings.enable_rough_notation and section.settings.design_system != 'global_style' or block.settings.override or block.settings.custom_style_name == 'custom' }}",
      "type": "range",
      "id": "annotation_duration",
      "label": "Animation duration",
      "min": 0,
      "max": 3000,
      "step": 100,
      "default": 800,
