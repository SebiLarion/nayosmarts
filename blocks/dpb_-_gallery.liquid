{%- capture js_scripts -%}
  <script type="application/json" data-dsgn-pck="{{ block_id }}">
    {
      "id": {{ block_id | json }},
      "cart_add_url": {{ routes.cart_add_url | json }},
      "add_to_cart_option": {{ block.settings.add_to_cart_option | json }},
      "custom_theme_trigger": {{ block.settings.custom_theme_trigger | json }},
      "slide_by_group": {{ block.settings.slide_by_group | json }}
    }
  </script>
  <script type="module" defer>
    class GalleryBlock extends HTMLElement {
      constructor() {
        super();
        this.blockWrapper = this.closest('.dsgn-pck__block');
        this.slider = this.querySelector('.dsgn-pck__slider-block');
        this.prevButtons = Array.from(this.querySelectorAll('.dsgn-pck__nav-button--prev'));
        this.nextButtons = Array.from(this.querySelectorAll('.dsgn-pck__nav-button--next'));
        this.track = this.querySelector("[data-slider-track]");
        // Find the settings script within the block wrapper
        const script = this.blockWrapper ? this.blockWrapper.querySelector('script[data-dsgn-pck]') : null;
        this.settings = script ? JSON.parse(script.textContent) : {};
      }

      connectedCallback() {
        this.enablePrevNextButtons();
        // Event delegation for add-to-cart buttons
        this.blockWrapper.addEventListener('click', this.handleAddToCartClick.bind(this));
      }

      disconnectedCallback() {
        // Clean up event listeners if needed
        this.blockWrapper.removeEventListener('click', this.handleAddToCartClick.bind(this));
        // Clean up resize observer
        if (this.resizeObserver) {
          this.resizeObserver.disconnect();
          this.resizeObserver = null;
        }
      }

      handleAddToCartClick(e) {
        const button = e.target.closest('[data-dsgn-pck-add-to-cart]');
        if (!button) return;
        const addToCartOption = button.dataset.dsgnPckAddToCart;
        if (addToCartOption === 'refresh' || addToCartOption === 'custom_theme_trigger') {
          e.preventDefault();
          const form = button.closest('form');
          if (!form) return;
          const variantId = form.querySelector('[name="id"]').value;
          const quantity = form.querySelector('[name="quantity"]').value;
          this.addItemToCart(variantId, quantity, addToCartOption);
        }
      }

      addItemToCart(variantId, quantity, addToCartOption) {
        fetch(this.settings.cart_add_url, {
          method: 'post',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            quantity: quantity,
            id: variantId,
          })
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        })
        .then((resp) => {
          if (addToCartOption === 'custom_theme_trigger') {
            const customCode = this.settings.custom_theme_trigger;
            if (customCode) {
              try {
                // Execute custom code with response
                const executeCustomCode = new Function('response', customCode);
                executeCustomCode(resp);
              } catch (error) {
                console.error('Error executing custom theme trigger:', error);
                location.reload();
              }
            } else {
              location.reload();
            }
          } else {
            location.reload();
          }
        })
        .catch((error) => {
          console.error('Error adding item to cart:', error);
          location.reload();
        });
      }

      enablePrevNextButtons() {
        if (!this.track || this.prevButtons.length === 0 || this.nextButtons.length === 0) return;

        const slideByGroup = this.settings.slide_by_group === true;
        const setButtonState = (button, isDisabled) => {
          if (!button) return;
          button.classList.toggle("dsgn-pck__disabled", isDisabled);
          button.disabled = isDisabled;
        };

        // Helper to update button states
        const updateButtonStates = () => {
          const trackScrollWidth = this.track.scrollWidth;
          const trackOuterWidth = this.track.clientWidth;

          this.prevButtons.forEach((button) => setButtonState(button, false));
          this.nextButtons.forEach((button) => setButtonState(button, false));

          if (this.track.scrollLeft <= 0) {
            this.prevButtons.forEach((button) => setButtonState(button, true));
          }

          let scrollLeft = this.track.scrollLeft + 1;
          if (scrollLeft > trackScrollWidth - trackOuterWidth) {
            this.nextButtons.forEach((button) => setButtonState(button, true));
          }
        };

        // Calculate scroll amount based on setting
        const getScrollAmount = () => {
          if (slideByGroup) {
            // Scroll by the visible track width (all visible items at once)
            return this.track.clientWidth;
          }

          const firstItem = this.track.querySelector('.dsgn-pck__block');
          if (!firstItem) return this.track.clientWidth;

          const trackStyles = getComputedStyle(this.track);
          const rawGap = trackStyles.columnGap || trackStyles.gap || '0';
          const gap = Number.parseFloat(rawGap) || 0;

          // Scroll by one slide width + gap
          return firstItem.offsetWidth + gap;
        };

        // Initial state - use requestAnimationFrame to ensure layout is complete
        requestAnimationFrame(() => {
          updateButtonStates();
        });

        // Watch for container resize to recalculate button states
        if (!this.resizeObserver) {
          this.resizeObserver = new ResizeObserver(() => {
            updateButtonStates();
          });
          this.resizeObserver.observe(this.track);
        }

        // Remove previous listeners if any
        this.track.onscroll = null;
        this.prevButtons.forEach((button) => {
          button.onclick = null;
        });
        this.nextButtons.forEach((button) => {
          button.onclick = null;
        });

        // Add listeners
        this.track.addEventListener("scroll", updateButtonStates);
        this.prevButtons.forEach((button) => {
          button.addEventListener('click', () => {
            this.track.scrollTo({
              left: this.track.scrollLeft - getScrollAmount(),
              behavior: "smooth"
            });
          });
        });
        this.nextButtons.forEach((button) => {
          button.addEventListener('click', () => {
            this.track.scrollTo({
              left: this.track.scrollLeft + getScrollAmount(),
              behavior: "smooth"
            });
          });
        });
      }
    }

    if (!customElements.get('dp-gallery-block')) {
      customElements.define('dp-gallery-block', GalleryBlock);
    }
  </script>
{%- endcapture -%}

<div id="DP--{{ block.id }}" class="DP--{{ block.id }} dsgn-pck__block dsgn-pck__block-id-{{ block.id }} dsgn-pck__block--{{ block.type }} dsgn-pck__block--{{ block.index }} dsgn-pck__justify-{%- if block.settings.horizontal_alignment != 'default' -%}{{ block.settings.horizontal_alignment }}{%- else -%}{{ section.settings.text_alignment }}{%- endif -%}" {{ block.shopify_attributes }}>
  {{ css_styles }}
    {%- capture prev_next_buttons -%}
      <div class="dsgn-pck__prev-next__wrapper dsgn-pck__prev-next__wrapper--desktop">
        <button type="button" class="dsgn-pck__nav-button dsgn-pck__nav-button--prev dsgn-pck__disabled" aria-label="Previous items" disabled>
        </button>
        <button type="button" class="dsgn-pck__nav-button dsgn-pck__nav-button--next" aria-label="Next items">
        </button>
      </div>
    {%- endcapture -%}
    {%- capture mobile_prev_next_buttons -%}
      <div class="dsgn-pck__prev-next__wrapper dsgn-pck__prev-next__wrapper--mobile">
        <button type="button" class="dsgn-pck__nav-button dsgn-pck__nav-button--prev dsgn-pck__disabled" aria-label="Previous items" disabled>
        </button>
        <button type="button" class="dsgn-pck__nav-button dsgn-pck__nav-button--next" aria-label="Next items">
        </button>
      </div>
    {%- endcapture -%}
    <dp-gallery-block class="dsgn-pck__slider" data-slider>
      {%- if block.settings.arrow_display == 'right' or block.settings.arrow_display == 'left' -%}
        {{ prev_next_buttons }}
      {%- endif -%}
      {%- if block.settings.mobile_arrow_display == 'right' or block.settings.mobile_arrow_display == 'left' -%}
        {{ mobile_prev_next_buttons }}
      {%- endif -%}
      <div class="dsgn-pck__slider-track dsgn-pck__format-{{ block.settings.format }} dsgn-pck__mobile-format-{{ block.settings.mobile_format }}" data-slider-track>
        {%- if block.settings.arrow_display == 'center' -%}
          {{ prev_next_buttons }}
        {%- endif -%}
        {%- if block.settings.mobile_arrow_display == 'center' -%}
          {{ mobile_prev_next_buttons }}
        {%- endif -%}
        {% content_for 'blocks' %}
      </div>
      {%- if block.settings.arrow_display == 'bottom_left' or block.settings.arrow_display == 'bottom_right' or block.settings.arrow_display == 'bottom_center' -%}
        {{ prev_next_buttons }}
      {%- endif -%}
      {%- if block.settings.mobile_arrow_display == 'bottom_left' or block.settings.mobile_arrow_display == 'bottom_right' or block.settings.mobile_arrow_display == 'bottom_center' -%}
        {{ mobile_prev_next_buttons }}
      {%- endif -%}
    </dp-gallery-block>
  {{ js_scripts }}
</div>

