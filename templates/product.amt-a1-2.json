        "collapsible_tab_JMJqJc": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "devices",
            "heading": "Will My Device Fit?",
            "content": "<ul><li><strong>What can I fit in?</strong><br/><br/>A1 can Fits laptops up to 18 inches, tablet, two phones, charger, cables, headphones, SSD, A4 documents, notebook, pens, passport, wallet, boarding passes, access cards, keys, compact umbrella, water bottle, a compact wash bag, personal medication and  Clothing for a 1–2 night business trip.</li></ul><p></p><ul><li><strong>Carry-On Information</strong><br/><br/>A1’s external dimensions fit within many common cabin-bag size limits, but airline baggage requirements vary by carrier, route and ticket type; always check the current airline rules before departure.</li></ul>",
