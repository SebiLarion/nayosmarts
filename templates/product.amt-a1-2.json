        "collapsible_tab_93tAeA": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "award",
            "heading": "Features",
            "content": "<ul><li><strong>Executive Mobility System</strong><br/>A structured 26L system for technology, business essentials and a focused 48-hour travel load.</li><li><strong>Independent Device Vault</strong><br/>Keeps your laptop, tablet and charging gear protected and separate.</li><li><strong>Antimicrobial Living Compartment</strong><br/>Stores clothing, toiletries and medication in a separate antimicrobial-lined space.</li><li><strong>Quick-Access Compartment</strong><br/>Keeps your phone, passport, keys and travel essentials within easy reach.</li><li><strong>Executive Admin Compartment</strong><br/>Organizes notebooks, pens, documents and contracts for business use.</li><li><strong>Hidden Security Compartment</strong><br/>Keeps passports, wallets and valuables discreetly out of sight.</li><li><strong>48-Hour Travel Capacity</strong><br/>Carries a complete work setup and a light one-to-two-night travel load.</li><li><strong>Three-Zone Carry System</strong><br/>Improves stability and keeps a fully loaded backpack closer to the body.</li><li><strong>Premium Weather-Resistant Build</strong><br/>420D nylon, YKK zippers and premium hardware support frequent business travel.</li></ul>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "collapsible_tab_j8pCA6": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "swatchbook",
            "heading": "Materials",
            "content": "<p><strong>Exterior Materials：</strong></p><ul><li><strong>Primary Fabric:</strong>  Matte 420D twill nylon</li><li><strong>Surface Treatment:</strong>  C0 fluorine-free water-resistant finish</li><li><strong>Interior Lining:</strong> DuPont™ Silvadur™ Antimicrobial Polyester</li><li><strong>Detail Material:</strong> Refined recycled ECO Leather accents</li><li><strong>RFID Pocket:</strong> Signal-blocking pocket designed for compatible 13.56 MHz cards and passports</li><li><strong>Ventilation holes：</strong>Hypalon</li></ul><p></p><p><strong>Hardware, Zippers and Buckles</strong></p><ul><li><strong>Zippers:</strong> YKK zippers</li><li><strong>Magnetic Hardware:</strong> FIDLOCK magnetic buckle</li><li><strong>Adjustment Buckles</strong>: UTX-Duraflex engineering-grade buckles and components</li><li><strong>Sternum Strap Hardware: </strong>Woojin magnetic and adjustment hardware<br/></li></ul><p><strong>Weather Resistance</strong></p><ul><li><strong>Water Resistance:</strong> Designed for daily drizzle and incidental splashes</li><li><strong>Usage Limitation:</strong> Avoid prolonged heavy rain, immersion and extended exposure to wet conditions.</li></ul><p></p><p><strong>Carry System</strong></p><ul><li><strong>Back Panel:</strong> Three-zone structured back panel</li><li><strong>Airflow Design:</strong> Central airflow channel with breathable three-dimensional mesh</li><li><strong>Shoulder Straps</strong>: Curved 13 mm layered shoulder straps</li><li><strong>Shoulder Strap Materials:</strong> Structural EVA, high-rebound foam and breathable mesh.</li></ul><p></p><p><strong>Care Instructions</strong><br/>Spot clean using a soft, damp cloth and mild dish soap. Do not machine wash, bleach, tumble dry or expose the backpack to direct heat. Allow it to air dry completely before storage.</p>",
            "page": "",
            "liquid": "",
            "text_size": "text-sm"
          }
        },
        "collapsible_tab_wPPHkq": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "ruler",
            "heading": "Dimensions",
            "content": "<p><strong>Capacity: </strong>26L</p><p><br/><strong>Weight: </strong>1.7 kg / 3.75 lb before loading</p><p><br/><strong>Dimensions:</strong></p><ul><li>Height: 19.3\" (49cm)</li><li>Length: 11.4\" (29cm)</li><li>Width: 7.1\" (18cm)</li></ul>",
            "page": "",
