],"name":"t:sections.lookbook.name","settings":{"image":"shopify:\/\/shop_images\/PC-HL1-2.jpg","image_mobile":"shopify:\/\/shop_images\/HL1-2.jpg","heading":"","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","heading_position":"none","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":0,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false}},"faq_8dteGF":{"type":"faq","blocks":{"question_mrPKgf":{"type":"question","settings":{"title":"<strong>What makes the Herman HL1 different from ordinary sling bags?<\/strong>","text":"<p>The HL1 combines luxury-inspired materials, a minimalist flap silhouette, Fidlock® magnetic hardware, waterproof SBS® zippers, and organized internal storage in a compact EDC format. It is designed to balance style, functionality, and premium craftsmanship.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_zNhUEA":{"type":"question","settings":{"title":"<strong>Is the Herman HL1 suitable for everyday carry (EDC)?<\/strong>","text":"<p>Yes. The HL1 is purpose-built as a premium EDC sling bag, offering lightweight carry, smart organization, multiple pockets, and quick-access storage for daily essentials.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_4Dz6RT":{"type":"question","settings":{"title":"<strong>What can fit inside the Herman HL1?<\/strong>","text":"<p>The 4.2L capacity is ideal for your phone, wallet, keys, earbuds, power bank, passport, sunglasses, Kindle, Nintendo Switch, and iPad mini. Dedicated compartments help keep everything organized and easy to access.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_jQh9Pe":{"type":"question","settings":{"title":"<strong>Does the Herman HL1 fit an iPad?<\/strong>","text":"<p>Yes. The dedicated tablet compartment fits iPad mini models up to 8.3 inches, providing padded protection during daily commutes and travel.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_iAw4gf":{"type":"question","settings":{"title":"<strong>Is the Herman HL1 a good gift?<\/strong>","text":"<p>Yes. With its premium hardware, refined appearance, practical organization, and versatile everyday use, the Herman HL1 is a popular gift for professionals, travelers, tech lovers, and EDC enthusiasts.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_pnpgRL":{"type":"question","settings":{"title":"<strong>The Herman HL1 is ideal for?<\/strong>","text":"<ul><li>Daily commuting<\/li><li>Urban EDC<\/li><li>Travel and sightseeing<\/li><li>Coffee shop work sessions<\/li><li>Weekend outings<\/li><li>Camera and tech carry<\/li><li>Premium gift giving<\/li><\/ul>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_3YhhPK":{"type":"question","settings":{"title":"<strong>Is HL1 waterproof?<\/strong>","text":"<p>No. The product is water-resistant for light rain and splashes.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_mrPKgf","question_zNhUEA","question_4Dz6RT","question_jQh9Pe","question_iAw4gf","question_pnpgRL","question_3YhhPK"],"name":"t:sections.faq.name","settings":{"style":"with-background","heading":"FREQUENTLY ASKED QUESTIONS","heading_size":"title-sm","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_backgro