"","color_text":"#ffffff","vertical":23,"horizontal":43,"vertical_mobile":34,"horizontal_mobile":54}},"content_P6D4pW":{"type":"content","settings":{"icon":"none","iwidth":"custom","icon_width":10,"heading":"Back Luggage Strap","text":"<p>Secure the luggage strap over your suitcase handle for easy travel. <\/p>","link":"","color_text":"#ffffff","vertical":56,"horizontal":46,"vertical_mobile":56,"horizontal_mobile":46}},"content_tacJJD":{"type":"content","settings":{"icon":"none","iwidth":"custom","icon_width":10,"heading":"Dedicated Laptop & Tech Compartment","text":"<ul><li>Small size fits laptops up to 16\", large size fits up to 18\"<\/li><li>Includes a tablet sleeve for extra device protection<\/li><li>Two elastic mesh pockets for cables and accessories<\/li><li>One horizontal zippered pocket for power banks, gaming consoles, and portable keyboards<\/li><li>Keeps all your daily tech essentials organized and easily accessible<br\/><\/li><\/ul>","link":"","color_text":"#ffffff","vertical":23,"horizontal":52,"vertical_mobile":36,"horizontal_mobile":32}},"content_gC7Pi6":{"type":"content","settings":{"icon":"none","iwidth":"custom","icon_width":10,"heading":"Back Compartment Accesses Front Compartment","text":"<p>Access items in the front main compartment easily through the zipper of the rear digital compartment—no need to open the top roll closure.<\/p>","link":"","color_text":"#ffffff","vertical":50,"horizontal":57,"vertical_mobile":38,"horizontal_mobile":70}},"content_hGMmiT":{"type":"content","settings":{"icon":"none","iwidth":"custom","icon_width":16,"heading":"Card Zipper Pocket on Shoulder Strap","text":"<p>Perfect for storing cards, coins, and small essentials.<\/p>","link":"","color_text":"#ffffff","vertical":62,"horizontal":53,"vertical_mobile":60,"horizontal_mobile":60}}},"block_order":["content_KkbDaf","content_P6D4pW","content_tacJJD","content_gC7Pi6","content_hGMmiT"],"name":"t:sections.lookbook.name","settings":{"image":"shopify:\/\/shop_images\/PC-H2-2.jpg","image_mobile":"shopify:\/\/shop_images\/H2-2.jpg","heading":"","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","heading_position":"none","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":0,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false}},"faq_ErLJce":{"type":"faq","blocks":{"question_a7ijff":{"type":"question","settings":{"title":"<strong>How much can the Herman H2 carry?<\/strong>","text":"<p>The roll-top capacity is approximately 23–25 liters, suitable for work equipment plus a light overnight or weekend load.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_QPhpjM":{"type":"question","settings":{"title":"<strong>Does the Herman H2 fit a 16-inch laptop?<\/strong>","text":"<p>Yes. It is designed for tested laptops up to 16 inches; confirm compatibility using internal dimensions and the device case.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_FEd48G":{"type":"question","settings":{"title":"<strong>Is the Herman H2 waterproof?<\/strong>","text":"<p>No. The Herman H2 uses water-resistant CORDURA® fabric, waterproof YKK® zippers, and a multi-layer protective construction that helps keep your belongings dry in rain and daily outdoor conditions. but the sewn backpack is not fully waterproof.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_94MdCb":{"type":"question","settings":{"title":"<strong>Is the Herman H2 suitable for air travel?<\/strong>","text":"<p>Yes. The Herman H2 is airline-approved, includes a luggage pass-through strap, and offers organized storage for travel documents, electronics, and 1–3 days of essentials.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_6rtdj3":{"type":"question","settings":{"title":"<strong>H2 or Herman Pro?<\/strong>","text":"<p>Choose <a href=\"\/products\/nayo-smart-herman-h2-half-roll-top-backpack\" target=\"_blank\" title=\"Herman H2 Half-Roll Top Backpack\">H2<\/a> for stronger material and protection emphasis. <br\/>Choose <a href=\"\/products\/herman-pro-half-roll-top-backpack-black\" target=\"_blank\" title=\"Herman Pro Half-Roll Top Backpack-Black\">Herman Pro <\/a>for two size options and a more refined business-travel silhouette.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_7FrbCT":{"type":"question","settings":{"title":"<strong>What is Herman H2 best for?<\/strong>","text":"<p>It is best for frequent work travel, one-bag weekends and users who prioritize durable materials and organized device carry.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_a7ijff","question_QPhpjM","question_FEd48G","question_94MdCb","question_6rtdj3","question_7FrbCT"],"name":"t:sections.faq.name","settings":{"style":"with-background","heading":"FREQUENTLY ASKED QUESTIONS","heading_size":"title-sm","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":0,"padding_bottom":0,"divider":false,"narrow":false,"rounded":false}},"lookbook_aPbhaX":{"type":"lookbook","disabled":true,"name":"t:sections.lookbook.name"