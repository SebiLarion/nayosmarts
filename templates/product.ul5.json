    "faq_3CxUa3": {
      "type": "faq",
      "blocks": {
        "question_DUenNj": {
          "type": "question",
          "settings": {
            "title": "<strong>What fits in the UL5 crossbody bag?</strong>",
            "text": "<p>UL5 is designed for a focused everyday load such as a phone, compact wallet, earbuds, keys, slim power bank, short cable, sunglasses and small personal items. Fit varies by the exact size and shape of each item</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_NQc4tk": {
          "type": "question",
          "settings": {
            "title": "<strong>What is X-Pac?</strong>",
            "text": "<p>X-Pac is a laminated composite material. UL5 uses X21/X42 construction with a durable nylon face, a structural layer and a waterproof film that also gives the material its recognizable grid texture</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_xWYE9B": {
          "type": "question",
          "settings": {
            "title": "<strong>Is UL5 waterproof?</strong>",
            "text": "<p>The X-Pac material includes a waterproof film, but the complete bag has stitched seams and is not fully waterproof. It is suitable for normal daily drizzle, not immersion or prolonged heavy rain</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_AAP8nR": {
          "type": "question",
          "settings": {
            "title": "<strong>How does the magnetic flap close?</strong>",
            "text": "<p>The magnetic strip helps guide the flap back into position and produces a clear closing sound. Open and close it with one hand while the bag is stable.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_cdpADt": {
          "type": "question",
          "settings": {
            "title": "<strong>What is the side pocket for?</strong>",
            "text": "<p>The side zipper pocket is sized for a small high-frequency item such as earbuds, keys or a transit card.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_mnQCxQ": {
          "type": "question",
          "settings": {
            "title": "<strong>Does UL5 have an AirTag pocket?</strong>",
            "text": "<p>Yes. UL5 includes a small internal pocket for an Apple AirTag or a similarly sized tracker. The tracker is sold separately.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_m7JTm6": {
          "type": "question",
          "settings": {
            "title": "<strong>Can UL5 be worn crossbody and over one shoulder?</strong>",
            "text": "<p>Yes. Adjust the strap for back, side, front or one-shoulder carry. Fit depends on body height, clothing and load.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
