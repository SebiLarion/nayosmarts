    "faq_c9cT7Y": {
      "type": "faq",
      "blocks": {
        "question_emmPwR": {
          "type": "question",
          "settings": {
            "title": "<strong>Who is the U9 designed for?</strong>",
            "text": "<p>U9 is designed for daily commuters and professionals who want a clean, lightweight backpack with smarter organization and faster access to their work essentials.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_W7VUKA": {
          "type": "question",
          "settings": {
            "title": "<strong>Is 20L enough for everyday work?</strong>",
            "text": "<p>Yes. U9 stays compact at 20L for everyday work essentials, then expands to 24L when you need extra room for a jacket, gym gear or other after-work essentials—without carrying a bulky backpack all day.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_TDtUTN": {
          "type": "question",
          "settings": {
            "title": "<strong>How does the U9 keep everything organized?</strong>",
            "text": "<p>Nine dedicated storage zones keep your tech, cables, keys, bottle and smaller essentials separated and easy to find, so you spend less time digging through your bag.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_f3eHpC": {
          "type": "question",
          "settings": {
            "title": "<strong>Can I access my laptop without opening the main compartment?</strong>",
            "text": "<p>Yes. U9 has a dedicated laptop compartment that lets you reach your device directly without unpacking or disturbing the rest of your carry.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_rELUNM": {
          "type": "question",
          "settings": {
            "title": "<strong>Is the U9 comfortable for all-day commuting?</strong>",
            "text": "<p>Yes. Padded shoulder straps and a breathable mesh back panel help distribute the load and reduce heat buildup, keeping the carry comfortable through walks, transit and full workdays.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_mRL3Cm": {
          "type": "question",
          "settings": {
            "title": "<strong>What makes the FIDLOCK buckle different from a regular buckle?</strong>",
            "text": "<p>The FIDLOCK magnetic buckle releases quickly and guides itself back into place when closing, making one-handed access faster and more intuitive throughout the day.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_EkLbjc": {
          "type": "question",
          "settings": {
            "title": "<strong>What makes the U9 different from a typical work backpack?</strong>",
            "text": "<p>U9 combines organized storage, quick laptop access, lightweight materials and intuitive details like the FIDLOCK closure in a cleaner, more refined design made for everyday work and commuting.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
